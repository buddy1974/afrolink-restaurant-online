---
import { Picture } from 'astro:assets';
import interior from '../assets/venue/interior.jpg';
import welcome from '../assets/venue/welcome-sign.jpg';
import kitchen from '../assets/venue/kitchen-pot.jpg';
import Rule from './Rule.astro';
import { services } from '../data/business';
import { type Lang } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="section on-ink about" id="about" aria-labelledby="about-title">
  <div class="wrap about__grid">
    <div class="about__text">
      <header class="section-head">
        <p class="eyebrow">{t.about.eyebrow}</p>
        <h2 id="about-title" class="section-title">{t.about.title}</h2>
      </header>
      <p class="about__p about__p--lead">{t.about.p1}</p>
      <p class="about__p">{t.about.p2}</p>

      <Rule class="about__rule" />

      <h3 class="about__h3">{t.about.services}</h3>
      <ul role="list" class="services">
        {services.map((s) => <li>{t.serviceNames[s]}</li>)}
      </ul>
    </div>

    <div class="about__media">
      <figure class="about__fig about__fig--kitchen">
        <Picture
          src={kitchen}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(min-width: 64em) 40vw, 100vw"
          alt={t.about.kitchenAlt}
          loading="lazy"
        />
        <figcaption>{t.about.kitchenCaption}</figcaption>
      </figure>
      <figure class="about__fig">
        <Picture
          src={interior}
          formats={['avif', 'webp']}
          widths={[480, 800, 1195]}
          sizes="(min-width: 64em) 20vw, 50vw"
          alt={t.about.roomAlt}
          loading="lazy"
        />
        <figcaption>{t.about.roomCaption}</figcaption>
      </figure>
      <figure class="about__fig">
        <Picture
          src={welcome}
          formats={['avif', 'webp']}
          widths={[480, 840]}
          sizes="(min-width: 64em) 20vw, 50vw"
          alt={t.about.signAlt}
          loading="lazy"
        />
        <figcaption>{t.about.signCaption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 64em) {
    .about__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(3rem, 1rem + 5vw, 6rem);
      align-items: start;
    }
  }
  .about__p {
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--on-ink-muted);
  }
  .about__p + .about__p {
    margin-top: 1rem;
  }
  .about__p--lead {
    color: var(--on-ink);
  }
  .about__text :global(.about__rule) {
    margin-block: 2.5rem 2rem;
    max-width: 22rem;
  }
  .about__h3 {
    margin-bottom: 1rem;
    font-size: var(--step--1);
    font-weight: 600;
    font-stretch: 112%;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ochre);
  }
  .services {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 32rem;
  }
  .services li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--ink-line);
  }
  .services li::before {
    content: '';
    flex: none;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--ochre);
    transform: rotate(45deg);
  }
  .about__media {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .about__fig--kitchen {
    grid-column: 1 / -1;
  }
  .about__fig :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .about__fig--kitchen :global(img) {
    aspect-ratio: 16 / 10;
    object-position: 100% 100%;
  }
  .about__fig figcaption {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }
  @media (max-width: 29.99em) {
    .services {
      grid-template-columns: 1fr;
    }
  }
</style>
