---
/** Minimal layout for the management area: no public navigation, never indexed. */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} – Afrolink Verwaltung</title>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #141110;
    --raised: #1f1a17;
    --line: #3a322c;
    --text: #f3ede3;
    --muted: #b9ad9c;
    --gold: #d6a84e;
    --bad: #e08a8a;
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 15px/1.5 system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  main {
    max-width: 78rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }
  h1 {
    font-size: 1.6rem;
    margin: 0 0 0.25rem;
  }
  h2 {
    font-size: 1.15rem;
    margin: 2.25rem 0 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--line);
    color: var(--gold);
  }
  a {
    color: var(--gold);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: 0.4rem 0.5rem;
    text-align: left;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  th {
    color: var(--muted);
    font-weight: 600;
    font-size: 0.85rem;
  }
  .num {
    text-align: right;
  }
  .scroll {
    overflow-x: auto;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.75rem;
  }
  .card {
    padding: 0.9rem 1rem;
    background: var(--raised);
    border: 1px solid var(--line);
  }
  .card b {
    display: block;
    font-size: 1.5rem;
  }
  .muted {
    color: var(--muted);
  }
  .bar {
    display: inline-block;
    height: 0.7rem;
    background: var(--gold);
    vertical-align: middle;
  }
  form.inline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }
  input,
  select,
  button {
    font: inherit;
    color: var(--text);
    background: var(--raised);
    border: 1px solid var(--line);
    padding: 0.35rem 0.55rem;
  }
  button {
    cursor: pointer;
    border-color: var(--gold);
  }
  .warn {
    color: var(--bad);
  }
  .note {
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--gold);
    background: var(--raised);
  }
</style>
