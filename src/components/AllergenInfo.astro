---
/**
 * Allergens & additives for one food item, in Afrolink's own voice.
 * Data: src/data/allergens.ts → publicAllergenInfo (Afrolink's menu declarations, or kitchen
 * confirmations once recorded). Provenance and reconciliation status stay internal
 * (docs/compliance/historical-allergen-register.md) and are never shown to guests.
 * Where nothing is declared, guests are invited to ask — never told a dish is allergen-free.
 */
import { publicAllergenInfo } from '../data/allergens';
import { phones } from '../data/business';
import { routes, type Lang } from '../i18n/config';
import { usePages } from '../i18n/pages';

interface Props {
  lang: Lang;
  id: string;
  /** compact: inside a menu card; full: on the dish page. */
  variant?: 'compact' | 'full';
}
const { lang, id, variant = 'compact' } = Astro.props;
const a = usePages(lang).allergen;
const info = publicAllergenInfo(id);
const listed = info.allergens.length + info.additives.length > 0;
// A confirmed record with empty lists means "nothing to declare"; otherwise we advise in person.
const state = listed ? 'listed' : info.status === 'confirmed' ? 'none' : 'ask';
---

<div class:list={['allergen', `allergen--${variant}`]} data-allergen={state}>
  {
    state === 'listed' && (
      <dl class="allergen__list">
        {info.allergens.length > 0 && (
          <div>
            <dt>{a.allergens}</dt>
            <dd>{info.allergens.map((x) => x.label[lang]).join(', ')}</dd>
          </div>
        )}
        {info.additives.length > 0 && (
          <div>
            <dt>{a.additives}</dt>
            <dd>{info.additives.map((x) => x.label[lang]).join(', ')}</dd>
          </div>
        )}
      </dl>
    )
  }
  {state === 'none' && <p>{a.noneDeclared}</p>}
  {state === 'ask' && <p>{a.noInfo}</p>}
  {variant === 'full' && <p class="allergen__note">{a.crossContact}</p>}
  <p class="allergen__help">{a.help}</p>
  <p class="allergen__links">
    <a href={phones.landline.href}>{a.call} {phones.landline.display}</a>
    <a href={routes.allergens[lang]}>{a.full}</a>
  </p>
</div>

<style>
  .allergen {
    display: grid;
    gap: 0.45rem;
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .allergen--full {
    font-size: var(--step-0);
  }
  .allergen__list {
    display: grid;
    gap: 0.25rem;
  }
  .allergen__list div {
    display: grid;
    grid-template-columns: minmax(6.5rem, auto) minmax(0, 1fr);
    gap: 0.75rem;
  }
  .allergen__list dt {
    font-weight: 650;
    color: var(--on-paper);
  }
  .allergen__list dd {
    overflow-wrap: anywhere;
  }
  /* Narrow menu cards: label above the values so long words (e.g. Geschmacksverstärker) fit. */
  .allergen--compact .allergen__list div {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }
  .allergen__note {
    color: var(--on-paper-muted);
  }
  .allergen__help {
    color: var(--on-paper);
  }
  .allergen__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .allergen__links a {
    color: var(--gold);
    font-weight: 600;
  }
</style>
