---
/**
 * Allergen & additive information page — Afrolink's own information for guests.
 * Food: declarations from src/data/allergens.ts (publicAllergenInfo); where nothing is declared,
 * guests are invited to ask. Drinks: only label-checked declarations.
 * Provenance, original menu codes and reconciliation notes stay internal
 * (docs/compliance/historical-allergen-register.md).
 * German is the legally relevant language; EN/FR link to it prominently.
 */
import LegalShell from './LegalShell.astro';
import { ALLERGENS, ADDITIVES, publicAllergenInfo, recordFor } from '../data/allergens';
import { usePages } from '../i18n/pages';
import { foodMenu } from '../data/menu';
import { drinksMenu } from '../data/drinks';
import { phones } from '../data/business';
import { allergenCopy } from '../i18n/legal-content';
import { routes, type Lang } from '../i18n/config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = allergenCopy[lang];
const a = usePages(lang).allergen;

const rows = (kind: 'food' | 'drink') =>
  (kind === 'food' ? foodMenu : drinksMenu).flatMap((cat) =>
    cat.items
      .filter((i) => i.available !== false)
      .map((i) => {
        const name = 'display' in i && i.display ? i.display[lang] : i.name;
        return { id: i.id, name, category: cat.title[lang] };
      }),
  );

/** Plain declaration text for a dish: "Allergene: … · Zusatzstoffe: …" or an invitation to ask. */
function foodText(id: string): { text: string; state: string } {
  const info = publicAllergenInfo(id);
  const parts = [
    info.allergens.length ? `${a.allergens}: ${info.allergens.map((x) => x.label[lang]).join(', ')}` : '',
    info.additives.length ? `${a.additives}: ${info.additives.map((x) => x.label[lang]).join(', ')}` : '',
  ].filter(Boolean);
  if (parts.length) return { text: parts.join(' · '), state: 'listed' };
  if (info.status === 'confirmed') return { text: a.noneDeclared, state: 'none' };
  return { text: c.pending, state: 'ask' };
}

function drinkText(id: string): { text: string; state: string } {
  const rec = recordFor(id);
  if (!rec || rec.status !== 'verified') return { text: c.pending, state: 'ask' };
  const allergens = (rec.allergens ?? []).map((code) => ALLERGENS.find((x) => x.code === code)!.name[lang]);
  const additives = (rec.additives ?? []).map((code) => ADDITIVES.find((x) => x.code === code)!.de);
  const parts = [allergens.length ? `${a.allergens}: ${allergens.join(', ')}` : '', additives.length ? `${a.additives}: ${additives.join(', ')}` : ''].filter(Boolean);
  return parts.length ? { text: parts.join(' · '), state: 'listed' } : { text: a.noneDeclared, state: 'none' };
}
---

<LegalShell lang={lang} route="allergens" title={c.title} lede={c.lede}>
  {
    lang !== 'de' && (
      <p class="german">
        {c.germanLink}{' '}
        <a href={routes.allergens.de} lang="de" hreflang="de">
          Allergene &amp; Zusatzstoffe (Deutsch)
        </a>
      </p>
    )
  }

  <section class="status" aria-labelledby="status-title">
    <h2 id="status-title">{c.statusTitle}</h2>
    <p>{c.statusText}</p>
    <p>{a.crossContact}</p>
    <p>
      <a href={phones.landline.href}>{a.call} {phones.landline.display}</a>
    </p>
  </section>

  {
    (['food', 'drink'] as const).map((kind) => (
      <section aria-labelledby={`t-${kind}`}>
        <h2 id={`t-${kind}`}>{kind === 'food' ? c.food : c.drinks}</h2>
        <div class="tablewrap">
          <table class="atable">
            <thead>
              <tr>
                <th scope="col">{c.tableDish}</th>
                <th scope="col">{c.tableStatus}</th>
              </tr>
            </thead>
            <tbody>
              {rows(kind).map((r) => {
                const f = kind === 'food' ? foodText(r.id) : drinkText(r.id);
                return (
                  <tr data-allergen={f.state}>
                    <th scope="row">
                      {r.name}
                      <span class="cat">{r.category}</span>
                    </th>
                    <td>{f.text}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }

  <section aria-labelledby="legend-a">
    <h2 id="legend-a">{c.legendAllergens}</h2>
    <dl class="legend">
      {
        ALLERGENS.map((a) => (
          <div>
            <dt>{a.code}</dt>
            <dd>{a.name[lang]}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-labelledby="legend-z">
    <h2 id="legend-z">{c.legendAdditives}</h2>
    <dl class="legend">
      {
        ADDITIVES.map((a) => (
          <div>
            <dt>{a.code}</dt>
            <dd lang="de">{a.de}</dd>
          </div>
        ))
      }
    </dl>
    <p class="fine">{c.additivesNote}</p>
  </section>
</LegalShell>

<style>
  .german {
    padding: 1rem 1.25rem;
    background: var(--paper-sunk);
    border-left: 3px solid var(--terracotta);
    font-weight: 550;
  }
  .status {
    display: grid;
    gap: 0.6rem;
    padding: 1rem 1.25rem;
    border: 1px solid rgb(214 168 78 / 0.55);
  }
  .status a {
    font-weight: 600;
    color: var(--gold);
  }
  .tablewrap {
    overflow-x: auto;
  }
  .atable {
    width: 100%;
    border-collapse: collapse;
  }
  .atable th,
  .atable td {
    padding: 0.6rem 0.5rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--paper-line);
  }
  .atable thead th {
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--terracotta);
    border-bottom: 1px solid var(--on-paper);
  }
  .atable tbody th {
    font-weight: 550;
  }
  .atable td {
    color: var(--on-paper-muted);
  }
  .cat {
    display: block;
    font-weight: 400;
    font-size: var(--step--1);
    color: var(--on-paper-muted);
  }
  .legend {
    display: grid;
    gap: 0;
  }
  @media (min-width: 48em) {
    .legend {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
  .legend > div {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.75rem;
    padding-block: 0.5rem;
    border-bottom: 1px solid var(--paper-line);
  }
  .legend dt {
    font-weight: 700;
    color: var(--terracotta);
  }
  .legend dd {
    margin: 0;
  }
  .fine {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--on-paper-muted);
  }
</style>
