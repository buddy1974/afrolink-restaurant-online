---
import { drinksMenu } from '../data/drinks';
import { formatPrice } from '../data/format';
import { type Lang } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** On the menu page headings move up one level (h2/h3 instead of h3/h4). */
  standalone?: boolean;
}
const { lang, standalone = false } = Astro.props;
const Title = standalone ? 'h2' : 'h3';
const CatTitle = standalone ? 'h3' : 'h4';
const t = useT(lang);

// Empty categories (e.g. Hot Drinks, not yet supplied) are not rendered.
const categories = drinksMenu
  .map((c) => ({ ...c, items: c.items.filter((i) => i.available !== false) }))
  .filter((c) => c.items.length > 0);
---

<section class="drinks on-ink" id="drinks" aria-labelledby="drinks-title">
  <div class="wrap">
    <header class="drinks__head">
      <p class="eyebrow">{t.drinks.eyebrow}</p>
      <Title id="drinks-title" class="drinks__title">{t.drinks.title}</Title>
      <p class="drinks__note" id="water-note">{t.drinks.waterNote}</p>
    </header>

    <div class="drink-grid">
      {
        categories.map((cat) => (
          <section class="dcat" aria-labelledby={`d-${cat.id}`} data-cat id={`drinks-${cat.id}`}>
            <CatTitle class="dcat__title" id={`d-${cat.id}`}>
              {cat.title[lang]}
            </CatTitle>
            {cat.subtitle && <p class="dcat__sub">{cat.subtitle[lang]}</p>}
            <ul role="list" class="drows">
              {cat.items.map((d) => {
                const name = d.display ? d.display[lang] : d.name;
                return (
                  <li
                    class="drow"
                    data-item
                    data-search={[name, d.name, cat.title[lang], cat.subtitle?.[lang]].filter(Boolean).join(' ')}
                    data-size-unverified={d.size && !d.size.verified ? '' : undefined}
                  >
                    <span class="drow__name">{name}</span>
                    <span class="drow__leader" aria-hidden="true" />
                    {d.size && <span class="drow__size">{d.size.value}</span>}
                    <span class="drow__price">{formatPrice(d.price, 'always')}</span>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .drinks {
    padding-block: clamp(3rem, 2rem + 3vw, 5rem);
    /* header + two-row category bar on phones; one row from 64em */
    scroll-margin-top: calc(var(--header-h) + 7.5rem);
  }
  @media (min-width: 64em) {
    .drinks {
      scroll-margin-top: calc(var(--header-h) + 3.5rem);
    }
  }
  .drinks__head {
    display: grid;
    gap: 0.5rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .drinks__note {
    max-width: 40rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--gold);
    color: var(--on-ink-muted);
    font-size: var(--step--1);
  }
  .drinks__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--step-4);
    line-height: 1.05;
  }
  .drink-grid {
    display: grid;
    gap: 2.5rem;
  }
  /* balanced columns: categories flow top-to-bottom, so short lists never leave a gap */
  @media (min-width: 48em) {
    .drink-grid {
      display: block;
      columns: 2;
      column-gap: clamp(2.5rem, 1rem + 4vw, 4.5rem);
    }
    .dcat {
      break-inside: avoid;
      padding-bottom: 2.5rem;
    }
  }
  @media (min-width: 75em) {
    .drink-grid {
      columns: 3;
    }
  }
  .dcat[hidden] {
    display: none;
  }
  .dcat__title {
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--on-ink);
    font-family: var(--font-serif);
    font-size: var(--step-2);
    font-weight: 400;
    line-height: 1.15;
  }
  .dcat__sub {
    margin-top: 0.5rem;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--on-ink-muted);
  }
  .drow {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--ink-line);
  }
  .drow[hidden] {
    display: none;
  }
  .drow:last-child {
    border-bottom: 0;
  }
  .drow__name {
    min-width: 0;
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.3;
  }
  .drow__leader {
    flex: 1 1 1rem;
    min-width: 1rem;
    border-bottom: 1px dotted rgb(243 237 227 / 0.3);
    transform: translateY(-0.3em);
  }
  .drow__size {
    flex: none;
    min-width: 3.4em;
    text-align: right;
    font-size: var(--step--1);
    color: var(--on-ink-muted);
    font-variant-numeric: tabular-nums;
  }
  .drow__price {
    flex: none;
    min-width: 4.2em;
    text-align: right;
    font-size: var(--step-1);
    font-weight: 600;
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--ochre);
  }
</style>
