---
import { Image } from 'astro:assets';
import logo from '../assets/brand/afrolink-logo.png';
import Rule from './Rule.astro';
import { business, phones } from '../data/business';

const year = new Date().getFullYear();
---

<footer class="footer on-ink">
  <div class="wrap">
    <Rule align="center" />
    <div class="footer__grid">
      <div class="footer__brand">
        <Image src={logo} alt="Afrolink Restaurant logo" width={72} height={69} densities={[1, 2]} loading="lazy" />
        <p>
          <strong>{business.name}</strong><br />
          {business.category}
        </p>
      </div>
      <p class="footer__addr">
        {business.address.street}<br />
        {business.address.postalCode} {business.address.city}
      </p>
      <p class="footer__tel">
        <a href={phones.landline.href}>{phones.landline.display}</a><br />
        <a href={phones.mobile.href}>{phones.mobile.display}</a>
      </p>
    </div>
    <p class="footer__legal">© {year} {business.name}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 3rem 2rem;
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }
  .footer__grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 48em) {
    .footer__grid {
      grid-template-columns: 2fr 1fr 1fr;
      align-items: center;
    }
  }
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .footer__brand :global(img) {
    width: 3.5rem;
  }
  .footer strong {
    color: var(--on-ink);
    font-weight: 600;
  }
  .footer a {
    display: inline-block;
    padding-block: 0.25rem;
    text-decoration: none;
  }
  .footer a:hover {
    color: var(--ochre);
  }
  .footer__legal {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink-line);
  }
</style>
