---
import { Image } from 'astro:assets';
import logo from '../assets/brand/afrolink-logo.png';
import Rule from './Rule.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { business, phones } from '../data/business';
import { routes, type Lang, type Paths, type RouteKey } from '../i18n/config';
import { useT } from '../i18n/ui';
import { usePages } from '../i18n/pages';
import { useConsentUi } from '../i18n/consent';
import { dishPaths } from '../i18n/config';

interface Props {
  lang: Lang;
  route: RouteKey;
  paths?: Paths;
}
const { lang, route } = Astro.props;
const t = useT(lang);
const year = new Date().getFullYear();
const p = usePages(lang);
const cs = useConsentUi(lang);
const pages = [
  { href: routes.menu[lang], label: p.nav.menu },
  { href: routes.soups[lang], label: p.nav.soups },
  { href: routes.delivery[lang], label: p.nav.delivery },
  { href: routes.catering[lang], label: p.nav.catering },
  { href: routes.reservations[lang], label: p.nav.reservations },
  { href: routes.gallery[lang], label: p.nav.gallery },
  { href: routes.contact[lang], label: p.nav.contact },
];
// A few well-known dishes as entry points (all dishes are linked from the menu page).
const dishes = [
  ['egusi-soup', 'Egusi Soup'],
  ['jollof-rice', 'Jollof Rice'],
  ['pepper-soup', 'Pepper Soup'],
  ['suya', 'Suya'],
  ['tilapia', 'Tilapia'],
  ['extra-pounded-yam', 'Pounded Yam'],
] as const;
---

<footer class="footer on-ink">
  <div class="wrap">
    <Rule align="center" />
    <div class="footer__grid">
      <div class="footer__brand">
        <Image src={logo} alt="Afrolink Restaurant" width={72} height={69} densities={[1, 2]} loading="lazy" />
        <p>
          <strong>{business.name}</strong><br />
          {business.address.street}<br />
          {business.address.postalCode} {business.address.city}
        </p>
      </div>
      <p class="footer__tel">
        <a href={phones.landline.href}>{phones.landline.display}</a><br />
        <a href={phones.mobile.href}>{phones.mobile.display}</a>
      </p>
      <nav class="footer__pages" aria-label={p.nav.pages}>
        <p class="footer__label">{p.nav.pages}</p>
        <ul role="list">
          {pages.map((x) => <li><a href={x.href}>{x.label}</a></li>)}
        </ul>
      </nav>
      <nav class="footer__dishes" aria-label={p.nav.dishes}>
        <p class="footer__label">{p.nav.dishes}</p>
        <ul role="list">
          {dishes.map(([id, name]) => <li><a href={dishPaths(id)[lang]}>{name}</a></li>)}
        </ul>
      </nav>
      <nav class="footer__legal" aria-label={t.footer.legal}>
        <ul role="list">
          <li><a href={routes.imprint[lang]}>{t.footer.imprint}</a></li>
          <li><a href={routes.privacy[lang]}>{t.footer.privacy}</a></li>
          <li><a href={routes.cookies[lang]}>{cs.page.title}</a></li>
          <li><button type="button" class="footer__consent" data-open-consent>{cs.settings.open}</button></li>
          <li><a href={routes.allergens[lang]}>{t.footer.allergens}</a></li>
        </ul>
      </nav>
      <div class="footer__langs">
        <p class="footer__label">{t.footer.language}</p>
        <LanguageSwitcher lang={lang} route={route} paths={Astro.props.paths} variant="full" label={t.footer.langNav} />
      </div>
    </div>
    <p class="footer__copy">© {year} {business.name}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: 3rem 2rem;
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }
  .footer__grid {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
  }
  @media (min-width: 48em) {
    .footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 72em) {
    .footer__grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr 1fr;
      align-items: start;
    }
  }
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .footer__brand :global(img) {
    width: 3.5rem;
  }
  .footer strong {
    color: var(--on-ink);
    font-weight: 600;
  }
  .footer a {
    display: inline-block;
    padding-block: 0.35rem;
    text-decoration: none;
  }
  .footer__consent {
    display: inline-block;
    padding: 0.35rem 0;
    font: inherit;
    color: inherit;
    text-align: left;
    background: none;
    border: 0;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .footer__consent:hover {
    color: var(--ochre);
  }
  .footer a:hover {
    color: var(--ochre);
  }
  .footer__label {
    margin-bottom: 0.25rem;
  }
  .footer__copy {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink-line);
  }
</style>
