---
import { Picture, getImage } from 'astro:assets';
import { gallery } from '../data/gallery';
import { galleryImage } from '../lib/images';
import { type Lang } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** On the dedicated gallery page the section title is the page's h1. */
  standalone?: boolean;
}
const { lang, standalone = false } = Astro.props;
const Heading = standalone ? 'h1' : 'h2';
const t = useT(lang);

const entries = await Promise.all(
  gallery.map(async (entry) => {
    const image = galleryImage(entry.file, 'gallery.ts');
    const full = await getImage({ src: image, width: Math.min(1600, image.width), format: 'webp' });
    return { ...entry, image, fullSrc: full.src, alt: entry.alt[lang], caption: entry.caption?.[lang] ?? '' };
  }),
);
---

<section class="section on-paper gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">{t.gallery.eyebrow}</p>
      <Heading id="gallery-title" class="section-title">{t.gallery.title}</Heading>
      <p class="section-lede">{t.gallery.lede}</p>
    </header>

    <ul role="list" class="grid" data-gallery>
      {
        entries.map((e) => (
          <li class:list={['tile', { 'tile--feature': e.feature }]}>
            <a href={e.fullSrc} class="tile__link" data-lb data-lb-group="gallery" data-lb-title={e.caption} data-lb-alt={e.alt}>
              <Picture
                src={e.image}
                formats={['avif', 'webp']}
                widths={[400, 800, 1200]}
                sizes={
                  e.feature
                    ? '(min-width: 75em) 36rem, (min-width: 48em) 66vw, 100vw'
                    : '(min-width: 75em) 18rem, (min-width: 48em) 33vw, 50vw'
                }
                alt={e.alt}
                loading="lazy"
                decoding="async"
                class:list={['tile__img', { 'is-watermarked': e.watermarked }]}
              />
              {e.caption && <span class="tile__cap">{e.caption}</span>}
              <span class="visually-hidden">— {t.gallery.open}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

</section>


<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-flow: dense;
    gap: clamp(0.5rem, 0.3rem + 0.8vw, 1rem);
  }
  @media (min-width: 48em) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 75em) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .tile {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--paper-sunk);
    overflow: hidden;
  }
  .tile--feature {
    grid-column: span 2;
    aspect-ratio: 8 / 5;
  }
  @media (min-width: 48em) {
    .tile--feature {
      grid-row: span 2;
      aspect-ratio: auto;
    }
  }
  .tile__link {
    display: block;
    height: 100%;
    color: var(--on-ink);
    text-decoration: none;
  }
  .tile__link:focus-visible {
    outline-offset: -3px;
    outline-color: var(--paper);
    box-shadow: inset 0 0 0 5px var(--terracotta);
  }
  .tile__link :global(picture),
  .tile__img {
    width: 100%;
    height: 100%;
  }
  .tile__img {
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .tile__img.is-watermarked {
    object-position: 100% 100%;
  }
  .tile__cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2rem 0.9rem 0.75rem;
    font-size: var(--step--1);
    font-weight: 550;
    letter-spacing: 0.04em;
    background: linear-gradient(to top, rgb(26 22 19 / 0.78), rgb(26 22 19 / 0));
  }
  @media (hover: hover) {
    .tile__cap {
      opacity: 0;
      transform: translateY(0.4rem);
      transition: opacity 0.3s ease, transform 0.3s ease;
    }
    .tile__link:hover .tile__img,
    .tile__link:focus-visible .tile__img {
      transform: scale(1.035);
    }
    .tile__link:hover .tile__cap,
    .tile__link:focus-visible .tile__cap {
      opacity: 1;
      transform: none;
    }
  }
</style>
