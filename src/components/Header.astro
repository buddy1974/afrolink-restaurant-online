---
import { Image } from 'astro:assets';
import logo from '../assets/brand/afrolink-logo.png';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { phones, whatsapp } from '../data/business';
import { routes, type Lang, type Paths, type RouteKey } from '../i18n/config';
import { useT } from '../i18n/ui';
import { usePages } from '../i18n/pages';

interface Props {
  lang: Lang;
  route: RouteKey;
  paths?: Paths;
}
const { lang, route } = Astro.props;
const t = useT(lang);
const p = usePages(lang);
// Site-wide navigation points to the dedicated pages (clear hierarchy for guests and search
// engines); reviews stay a section of the home page.
const nav: { href: string; label: string; key?: RouteKey }[] = [
  { href: routes.menu[lang], label: p.nav.menu, key: 'menu' },
  { href: routes.delivery[lang], label: p.nav.delivery, key: 'delivery' },
  { href: routes.catering[lang], label: p.nav.catering, key: 'catering' },
  { href: routes.reservations[lang], label: p.nav.reservations, key: 'reservations' },
  { href: route === 'home' ? '#reviews' : `${routes.home[lang]}#reviews`, label: p.nav.reviews },
  { href: routes.gallery[lang], label: p.nav.gallery, key: 'gallery' },
  { href: routes.contact[lang], label: p.nav.contact, key: 'contact' },
];
const isCurrent = (key?: RouteKey) => !!key && (key === route || (key === 'menu' && route === 'soups'));
---

<header class="site-header on-ink" data-header>
  <div class="wrap site-header__inner">
    <a class="brand" href={route === 'home' ? '#top' : routes.home[lang]}>
      <Image src={logo} alt="" width={44} height={42} densities={[1, 2]} loading="eager" class="brand__logo" />
      <span class="brand__text">
        <span class="brand__name">Afrolink</span>
        <span class="brand__sub"> Restaurant &amp; Bar</span>
      </span>
      <span class="visually-hidden"> – {t.a11y.toTop}</span>
    </a>

    <nav class="site-nav" aria-label={t.a11y.mainNav}>
      <ul role="list">
        {nav.map((n) => <li><a href={n.href} aria-current={isCurrent(n.key) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="header-actions">
      <div class="header-langs"><LanguageSwitcher lang={lang} route={route} paths={Astro.props.paths} label={t.a11y.langSwitch} /></div>
      <a class="hact" href={phones.landline.href}>
        <Icon name="phone" /><span class="hact__label">{t.actions.call}</span><span class="visually-hidden">
          {phones.landline.display}</span
        >
      </a>
      <a class="hact hact--wa" href={whatsapp.href} target="_blank" rel="noopener">
        <Icon name="whatsapp" /><span class="hact__label">{t.actions.whatsapp}</span><span class="visually-hidden">
          {t.a11y.opensWhatsApp}</span
        >
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
        <span class="menu-toggle__bars" aria-hidden="true"></span>
        <span class="visually-hidden" data-open-label={t.a11y.openNav} data-close-label={t.a11y.closeNav}>{t.a11y.openNav}</span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav hidden>
    <nav class="wrap" aria-label={t.a11y.mainNav}>
      <ul role="list" class="mobile-nav__list">
        {nav.map((n) => <li><a href={n.href} data-close-nav aria-current={isCurrent(n.key) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
      <div class="mobile-nav__langs">
        <LanguageSwitcher lang={lang} route={route} paths={Astro.props.paths} variant="full" label={`${t.a11y.langSwitch} (${t.a11y.mainNav})`} />
      </div>
      <div class="mobile-nav__actions">
        <a class="btn btn--solid" href={phones.landline.href}><Icon name="phone" /> {t.actions.call} {phones.landline.display}</a>
        <a class="btn btn--line" href={whatsapp.href} target="_blank" rel="noopener"><Icon name="whatsapp" /> {t.actions.whatsapp}</a>
        <a class="btn btn--line" href={phones.mobile.href}><Icon name="phone" /> {phones.mobile.display}</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const label = toggle?.querySelector<HTMLElement>('.visually-hidden');

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', String(open));
    panel.hidden = !open;
    document.documentElement.classList.toggle('nav-open', open);
    if (label) label.textContent = (open ? label.dataset.closeLabel : label.dataset.openLabel) ?? '';
    if (open) panel.querySelector<HTMLElement>('a')?.focus();
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  panel?.querySelectorAll('[data-close-nav]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
  matchMedia('(min-width: 87.5em)').addEventListener('change', (e) => e.matches && setOpen(false));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--ink-line);
  }
  .site-header__inner {
    max-width: calc(84rem + 2 * var(--gutter));
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    margin-right: auto;
    min-height: 2.75rem;
  }
  .brand__logo {
    width: 2.6rem;
    height: auto;
  }
  .brand__text {
    display: grid;
    line-height: 1.05;
  }
  .brand__name {
    white-space: nowrap;
    font-size: 1.05rem;
    font-weight: 650;
    font-stretch: 122%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .brand__sub {
    white-space: nowrap;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
  }

  .site-nav {
    display: none;
  }
  .site-nav ul {
    display: flex;
    gap: clamp(0.9rem, 0.1rem + 1.2vw, 1.6rem);
  }
  .site-nav a {
    display: block;
    white-space: nowrap;
    padding-block: 0.6rem;
    font-size: 0.8125rem;
    font-weight: 550;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--on-ink-muted);
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .site-nav a:hover {
    color: var(--on-ink);
    border-color: var(--ochre);
  }
  .site-nav a[aria-current='page'] {
    color: var(--gold);
    border-color: var(--gold);
  }
  .mobile-nav__list a[aria-current='page'] {
    color: var(--gold);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .header-langs {
    display: none;
  }
  .hact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--on-ink);
    border: 1px solid var(--ink-line);
    border-radius: 2px;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }
  .hact :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }
  .hact:hover {
    border-color: var(--ochre);
    color: var(--ochre);
  }
  .hact--wa {
    background: var(--ochre);
    border-color: var(--ochre);
    color: var(--ink);
  }
  .hact--wa:hover {
    background: var(--on-ink);
    border-color: var(--on-ink);
    color: var(--ink);
  }
  .hact__label {
    display: none;
  }

  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    min-height: 2.75rem;
    margin-left: 0.25rem;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .menu-toggle__bars,
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    display: block;
    width: 1.25rem;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .menu-toggle__bars {
    position: relative;
  }
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .menu-toggle__bars::before {
    top: -6px;
  }
  .menu-toggle__bars::after {
    top: 6px;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars {
    background: transparent;
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::before {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-nav {
    position: fixed;
    inset: var(--header-h) 0 0 0;
    overflow-y: auto;
    background: var(--ink);
    border-top: 1px solid var(--ink-line);
    padding-block: 1.5rem 3rem;
  }
  .mobile-nav__list a {
    display: flex;
    align-items: center;
    min-height: 3.25rem;
    font-family: var(--font-serif);
    font-size: 1.6rem;
    text-decoration: none;
    border-bottom: 1px solid var(--ink-line);
  }
  .mobile-nav__langs {
    margin-top: 1.5rem;
  }
  .mobile-nav__actions {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  :global(html.nav-open) {
    overflow: hidden;
  }

  @media (max-width: 23.99em) {
    .brand__sub {
      letter-spacing: 0.08em;
    }
    .brand__logo {
      width: 2.25rem;
    }
  }
  @media (min-width: 30em) {
    .hact__label {
      display: inline;
    }
    .hact {
      padding-inline: 0.85rem;
    }
  }
  @media (min-width: 48em) {
    .header-langs {
      display: block;
      margin-right: 0.5rem;
    }
    .mobile-nav__langs {
      display: none;
    }
  }
  /* Full text navigation only where it measurably fits in DE/EN/FR (≥ 1400 px). */
  @media (min-width: 87.5em) {
    .site-nav {
      display: block;
      margin-inline: auto;
    }
    .menu-toggle {
      display: none;
    }
    .brand {
      margin-right: 0;
    }
  }
</style>
