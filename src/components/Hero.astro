---
import { Picture } from 'astro:assets';
import heroImage from '../assets/gallery/egusi-pounded-yam.jpg';
import Icon from './Icon.astro';
import Rule from './Rule.astro';
import { google, phones } from '../data/business';
import { openingHours, timeZone } from '../data/hours';
import { type Lang } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const rating = google.rating.toLocaleString(lang === 'en' ? 'en-GB' : lang, { minimumFractionDigits: 1 });
---

<section class="hero on-ink" id="top" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__name">Afrolink</span>
        <span class="hero__sub">Restaurant &amp; Bar</span>
      </h1>
      <Rule class="hero__rule" />
      <p class="hero__tagline">{t.hero.tagline}</p>
      <p class="hero__intro">{t.hero.intro}</p>

      <div class="hero__ctas">
        <a class="btn btn--solid hero__primary" href="#menu">{t.actions.viewMenu} <Icon name="arrow" /></a>
        <div class="hero__secondary">
          <a class="btn btn--line" href="#enquiry" data-enquiry="delivery">{t.actions.delivery}</a>
          <a class="btn btn--line" href="#enquiry" data-enquiry="reservation">{t.actions.reserve}</a>
          <a class="btn btn--line" href={phones.landline.href}><Icon name="phone" /> {t.actions.call}</a>
        </div>
      </div>

      <ul role="list" class="hero__facts">
        <li>
          <a href="#reviews" class="fact">
            <span class="fact__stars" aria-hidden="true">★</span>
            <span><strong>{rating}</strong> {t.hero.ratingLabel} · {google.reviewCount} {t.hero.reviewsCount}</span>
          </a>
        </li>
        <li class="fact fact--today" data-today data-tz={timeZone} data-hours={JSON.stringify(openingHours)}>
          <span class="fact__dot" aria-hidden="true"></span>
          <span>{t.hero.todayOpen} <strong data-today-hours></strong></span>
        </li>
        <li>
          <a href="#david" class="fact">
            <span class="fact__play" aria-hidden="true">▶</span>
            <span>{t.hero.watchVideo}</span>
          </a>
        </li>
      </ul>
    </div>

    <figure class="hero__media">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        widths={[480, 720, 883]}
        sizes="(min-width: 76em) 40rem, (min-width: 56em) 50vw, 100vw"
        alt={t.hero.imageAlt}
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <figcaption class="hero__caption">{t.hero.caption}</figcaption>
    </figure>
  </div>
</section>

<script>
  // "Open today hh:mm–hh:mm" in the restaurant's time zone (before 05:00 counts as the previous evening).
  const el = document.querySelector<HTMLElement>('[data-today]');
  if (el) {
    try {
      const hours = JSON.parse(el.dataset.hours!) as { day: string; opens: string; closes: string }[];
      const tz = el.dataset.tz || 'Europe/Berlin';
      const now = new Date();
      const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: '2-digit', hourCycle: 'h23' }).format(now));
      const ref = hour < 5 ? new Date(now.getTime() - 6 * 3600 * 1000) : now;
      const day = new Intl.DateTimeFormat('en-GB', { timeZone: tz, weekday: 'long' }).format(ref);
      const today = hours.find((h) => h.day === day);
      const out = el.querySelector('[data-today-hours]');
      if (today && out) {
        out.textContent = `${today.opens}–${today.closes}`;
        el.classList.add('is-ready');
      }
    } catch {
      /* leave hidden */
    }
  }
</script>

<style>
  .hero {
    padding-block: clamp(1.75rem, 1rem + 3vw, 4rem) clamp(2.25rem, 1.5rem + 3vw, 4.5rem);
  }
  .hero__grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .hero__text {
    min-width: 0;
  }
  .hero__title {
    display: grid;
    gap: 0.5rem;
    font-weight: inherit;
  }
  .hero__name {
    font-family: var(--font-sans);
    font-size: clamp(2.6rem, 1.2rem + 4.2vw, 5rem);
    font-weight: 640;
    font-stretch: 125%;
    letter-spacing: 0.05em;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .hero__sub {
    font-size: var(--step-1);
    font-weight: 500;
    font-stretch: 115%;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
  }
  .hero__text :global(.hero__rule) {
    margin-block: 1.25rem 1rem;
    max-width: 22rem;
  }
  .hero__tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-3);
    line-height: 1.15;
    color: var(--ochre);
  }
  .hero__intro {
    max-width: 34rem;
    margin-top: 0.85rem;
    color: var(--on-ink-muted);
  }

  .hero__ctas {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.5rem;
    max-width: 36rem;
  }
  .hero__primary {
    justify-self: start;
  }
  .hero__secondary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .hero__secondary .btn {
    min-height: 2.75rem;
    padding: 0.6rem 1rem;
    font-size: 0.75rem;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ink-line);
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }
  .fact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    text-decoration: none;
  }
  a.fact:hover {
    color: var(--on-ink);
  }
  .fact strong {
    color: var(--on-ink);
    font-weight: 600;
  }
  .fact__stars {
    color: var(--ochre);
    font-size: 1.1em;
  }
  .fact__play {
    color: var(--ochre);
    font-size: 0.8em;
  }
  /* space is reserved from first paint (no layout shift); content appears once computed */
  .fact--today {
    visibility: hidden;
  }
  .fact--today.is-ready {
    visibility: visible;
  }
  .fact__dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--ochre);
    transform: rotate(45deg);
  }

  .hero__media {
    min-width: 0;
  }
  .hero__img {
    width: 100%;
    aspect-ratio: 883 / 540;
    object-fit: cover;
    /* Afrolink watermark sits bottom-right — keep it in frame */
    object-position: 100% 100%;
  }
  .hero__caption {
    margin-top: 0.5rem;
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }

  @media (max-width: 29.99em) {
    .hero__primary {
      justify-self: stretch;
    }
    .hero__secondary .btn {
      flex: 1 1 auto;
      padding-inline: 0.75rem;
      letter-spacing: 0.06em;
    }
  }
  @media (max-width: 55.99em) {
    /* phones/tablets: photo first, so food leads */
    .hero__media {
      order: -1;
    }
  }
  @media (min-width: 56em) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: clamp(2rem, 1rem + 3vw, 4rem);
    }
  }
</style>
