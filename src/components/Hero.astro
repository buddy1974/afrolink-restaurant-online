---
/**
 * Hero (approved design): large Egusi photograph, brand, tagline and primary actions.
 * Desktop: text left, photo bleeding to the right edge. Mobile: photo first.
 */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Rule from './Rule.astro';
import { galleryImage } from '../lib/images';
import { heroImage } from '../data/dish-images';
import { google, phones } from '../data/business';
import { openingHours, timeZone } from '../data/hours';
import { type Lang } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const img = galleryImage(heroImage.file, 'hero');
const locale = lang === 'en' ? 'en-GB' : lang;
const rating = google.rating.toLocaleString(locale, { minimumFractionDigits: 1 });
---

<section class="hero on-ink" id="top" aria-labelledby="hero-title">
  <div class="hero__grid">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__name">Afrolink</span>
        <span class="hero__sub">Restaurant &amp; Bar</span>
      </h1>
      <Rule class="hero__rule" />
      <p class="hero__tagline">{t.hero.tagline}</p>
      <p class="hero__intro">{t.hero.intro}</p>

      <div class="hero__ctas">
        <a class="btn btn--solid hero__primary" href="#menu">{t.actions.viewMenu} <Icon name="arrow" /></a>
        <a class="btn btn--line" href="#enquiry" data-enquiry="reservation">{t.actions.reserve}</a>
        <a class="btn btn--line" href="#enquiry" data-enquiry="delivery">{t.actions.delivery}</a>
        <a class="btn btn--line" href={phones.landline.href}><Icon name="phone" /> {phones.landline.display}</a>
      </div>

      <ul role="list" class="hero__facts">
        <li>
          <a href="#reviews" class="fact">
            <span class="fact__stars" aria-hidden="true">★</span>
            <span><strong>{rating}</strong> {t.hero.ratingLabel} · {google.reviewCount} {t.hero.reviewsCount}</span>
          </a>
        </li>
        <li class="fact fact--today" data-today data-tz={timeZone} data-hours={JSON.stringify(openingHours)}>
          <span class="fact__dot" aria-hidden="true"></span>
          <span>{t.hero.todayOpen} <strong data-today-hours></strong></span>
        </li>
        <li>
          <a href="#david" class="fact">
            <span class="fact__play" aria-hidden="true">▶</span>
            <span>{t.hero.watchVideo}</span>
          </a>
        </li>
      </ul>
    </div>

    <figure class="hero__media">
      <Picture
        src={img}
        formats={['avif', 'webp']}
        widths={[480, 720, 960, 1280, 1680]}
        sizes="100vw"
        alt={heroImage.alt[lang]}
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <figcaption class="hero__caption">{t.hero.caption}</figcaption>
    </figure>
  </div>
</section>

<script>
  // "Open today hh:mm–hh:mm" in the restaurant's time zone (before 05:00 counts as the previous evening).
  const el = document.querySelector<HTMLElement>('[data-today]');
  if (el) {
    try {
      const hours = JSON.parse(el.dataset.hours!) as { day: string; opens: string; closes: string }[];
      const tz = el.dataset.tz || 'Europe/Berlin';
      const now = new Date();
      const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: tz, hour: '2-digit', hourCycle: 'h23' }).format(now));
      const ref = hour < 5 ? new Date(now.getTime() - 6 * 3600 * 1000) : now;
      const day = new Intl.DateTimeFormat('en-GB', { timeZone: tz, weekday: 'long' }).format(ref);
      const today = hours.find((h) => h.day === day);
      const out = el.querySelector('[data-today-hours]');
      if (today && out) {
        out.textContent = `${today.opens}–${today.closes}`;
        el.classList.add('is-ready');
      }
    } catch {
      /* leave hidden */
    }
  }
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }
  .hero__grid {
    display: grid;
  }
  .hero__text {
    min-width: 0;
    padding: clamp(1.75rem, 1rem + 3vw, 3rem) var(--gutter) clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }
  .hero__title {
    display: grid;
    gap: 0.5rem;
    font-weight: inherit;
  }
  .hero__name {
    font-family: var(--font-sans);
    font-size: clamp(2.75rem, 1.2rem + 5vw, 5.75rem);
    font-weight: 640;
    font-stretch: 125%;
    letter-spacing: 0.05em;
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--on-ink);
  }
  .hero__sub {
    font-size: var(--step-1);
    font-weight: 500;
    font-stretch: 115%;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .hero__text :global(.hero__rule) {
    margin-block: 1.25rem 1rem;
    max-width: 22rem;
  }
  .hero__tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-3);
    line-height: 1.15;
    color: var(--on-ink);
  }
  .hero__intro {
    max-width: 34rem;
    margin-top: 0.85rem;
    color: var(--on-ink-muted);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
    max-width: 38rem;
  }
  .hero__ctas .btn--line {
    min-height: 3rem;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-top: 1.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--ink-line);
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }
  .fact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    text-decoration: none;
  }
  a.fact:hover {
    color: var(--on-ink);
  }
  .fact strong {
    color: var(--on-ink);
    font-weight: 600;
  }
  .fact__stars,
  .fact__play {
    color: var(--gold);
  }
  .fact__play {
    font-size: 0.8em;
  }
  .fact__dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--gold);
    transform: rotate(45deg);
  }
  /* space is reserved from first paint (no layout shift); content appears once computed */
  .fact--today {
    visibility: hidden;
  }
  .fact--today.is-ready {
    visibility: visible;
  }

  .hero__media {
    position: relative;
    min-width: 0;
    order: -1;
  }
  .hero__img {
    width: 100%;
    aspect-ratio: 1680 / 936;
    object-fit: cover;
    /* Afrolink watermark sits bottom-right — keep it in frame */
    object-position: 100% 100%;
  }
  .hero__caption {
    position: absolute;
    left: var(--gutter);
    bottom: 0.75rem;
    padding: 0.3rem 0.6rem;
    font-size: var(--step--1);
    color: var(--on-ink);
    background: rgb(20 17 16 / 0.72);
  }

  @media (max-width: 29.99em) {
    .hero__ctas .btn {
      flex: 1 1 calc(50% - 0.3rem);
      padding-inline: 0.75rem;
      letter-spacing: 0.06em;
    }
    .hero__primary {
      flex-basis: 100% !important;
    }
  }

  @media (min-width: 64em) {
    /* full-bleed photograph with the text set over a dark readability scrim on the left */
    .hero__grid {
      position: relative;
      min-height: min(84vh, 48rem);
      align-items: center;
    }
    .hero__text {
      position: relative;
      z-index: 1;
      max-width: calc(36rem + max(var(--gutter), calc((100vw - var(--max)) / 2)));
      padding-left: max(var(--gutter), calc((100vw - var(--max)) / 2));
      padding-right: 2rem;
    }
    .hero__media {
      position: absolute;
      inset: 0;
      order: 0;
    }
    .hero__media :global(picture),
    .hero__img {
      width: 100%;
      height: 100%;
    }
    .hero__img {
      aspect-ratio: auto;
      object-position: 100% 62%;
    }
    .hero__media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, rgb(20 17 16 / 0.94) 0%, rgb(20 17 16 / 0.86) 30%, rgb(20 17 16 / 0.35) 52%, rgb(20 17 16 / 0) 66%);
      pointer-events: none;
    }
    .hero__caption {
      left: auto;
      right: 1.25rem;
      bottom: auto;
      top: 1.25rem;
      z-index: 1;
    }
  }
</style>
