---
import { Picture } from 'astro:assets';
import heroImage from '../assets/gallery/nkwobi.jpg';
import Icon from './Icon.astro';
import Rule from './Rule.astro';
import { business, whatsapp } from '../data/business';
---

<section class="hero on-ink" id="top" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__name">Afrolink</span>
        <span class="hero__sub">Restaurant &amp; Bar</span>
      </h1>
      <Rule class="hero__rule" />
      <p class="hero__tagline">{business.tagline}</p>
      <p class="hero__intro">{business.intro}</p>
      <div class="hero__ctas">
        <a class="btn btn--solid" href="#menu">View Menu <Icon name="arrow" /></a>
        <a class="btn btn--line" href={whatsapp.href} target="_blank" rel="noopener">
          <Icon name="whatsapp" /> WhatsApp Us<span class="visually-hidden"> (opens WhatsApp)</span>
        </a>
      </div>
      <p class="hero__address">Berzeliusstraße 7 · 45144 Essen</p>
    </div>

    <figure class="hero__media">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 76em) 34rem, (min-width: 56em) 45vw, 100vw"
        alt="Nkwobi from the Afrolink kitchen, topped with onion rings and red pepper"
        loading="eager"
        fetchpriority="high"
        class="hero__img"
      />
      <figcaption class="hero__caption">Nkwobi · from our kitchen</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 1rem + 4vw, 5rem) clamp(3rem, 2rem + 4vw, 6rem);
  }
  .hero__grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .hero__title {
    display: grid;
    gap: 0.6rem;
    font-weight: inherit;
  }
  .hero__name {
    font-family: var(--font-sans);
    font-size: clamp(2.6rem, 1.2rem + 4.2vw, 5.25rem);
    font-weight: 640;
    font-stretch: 125%;
    letter-spacing: 0.05em;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .hero__sub {
    font-size: var(--step-1);
    font-weight: 500;
    font-stretch: 115%;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
  }
  .hero__text {
    min-width: 0;
  }
  .hero__text :global(.hero__rule) {
    margin-block: 1.5rem 1.25rem;
    max-width: 22rem;
  }
  .hero__tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-3);
    line-height: 1.15;
    color: var(--ochre);
  }
  .hero__intro {
    max-width: 32rem;
    margin-top: 1rem;
    color: var(--on-ink-muted);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .hero__address {
    /* no text-transform: uppercase would render ß as SS */
    margin-top: 1.75rem;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    color: var(--on-ink-muted);
  }

  .hero__media {
    position: relative;
  }
  @media (max-width: 55.99em) {
    .hero__grid {
      gap: 2rem;
    }
    .hero__ctas {
      margin-top: 1.5rem;
    }
    .hero__address {
      margin-top: 1.25rem;
    }
  }
  .hero__img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: 50% 45%;
  }
  .hero__caption {
    margin-top: 0.6rem;
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }

  @media (max-width: 29.99em) {
    .hero__ctas .btn {
      flex: 1 1 auto;
      padding-inline: 0.9rem;
      letter-spacing: 0.06em;
    }
  }
  @media (min-width: 56em) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: clamp(2rem, 1rem + 4vw, 5rem);
    }
    .hero__img {
      aspect-ratio: 4 / 5;
      max-height: min(72vh, 40rem);
    }
  }
</style>
