---
/** Minimal inline icon set (stroke icons + WhatsApp glyph). Decorative by default. */
interface Props {
  name: 'phone' | 'whatsapp' | 'pin' | 'arrow' | 'close' | 'prev' | 'next' | 'menu';
  label?: string;
}
const { name, label } = Astro.props;
const a11y = label ? { role: 'img' as const, 'aria-label': label } : { 'aria-hidden': 'true' as const };
---

{
  name === 'whatsapp' ? (
    <svg viewBox="0 0 24 24" fill="currentColor" {...a11y}>
      <path d="M12.04 2a9.9 9.9 0 0 0-8.5 15l-1.4 5.1 5.24-1.37A9.9 9.9 0 1 0 12.04 2Zm0 18.1a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.03-.2-.31a8.2 8.2 0 1 1 6.96 3.85Zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8-.23-.08-.39-.12-.55.12-.16.25-.63.8-.78.97-.14.16-.29.18-.53.06a6.7 6.7 0 0 1-3.32-2.9c-.25-.43.25-.4.72-1.33.08-.16.04-.3-.02-.43l-.75-1.82c-.2-.48-.4-.41-.55-.42h-.47a.9.9 0 0 0-.65.3 2.74 2.74 0 0 0-.86 2.04 4.77 4.77 0 0 0 1 2.53 10.9 10.9 0 0 0 4.18 3.7c1.55.67 2.16.73 2.94.61.47-.07 1.46-.6 1.66-1.18.2-.58.2-1.07.15-1.18-.06-.1-.22-.16-.47-.28Z" />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="square"
      stroke-linejoin="miter"
      {...a11y}
    >
      {name === 'phone' && (
        <path d="M5 3.5h3.6l1.6 4.4-2.3 1.5a11 11 0 0 0 6.7 6.7l1.5-2.3 4.4 1.6V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.1 1.5 1.5 0 0 1 5 3.5Z" />
      )}
      {name === 'pin' && (
        <>
          <path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21Z" />
          <circle cx="12" cy="9.8" r="2.3" />
        </>
      )}
      {name === 'arrow' && <path d="M5 12h13M13 6.5l5.5 5.5-5.5 5.5" />}
      {name === 'close' && <path d="M5.5 5.5l13 13M18.5 5.5l-13 13" />}
      {name === 'prev' && <path d="M15 5l-7 7 7 7" />}
      {name === 'next' && <path d="M9 5l7 7-7 7" />}
      {name === 'menu' && <path d="M3.5 7.5h17M3.5 12h17M3.5 16.5h17" />}
    </svg>
  )
}
