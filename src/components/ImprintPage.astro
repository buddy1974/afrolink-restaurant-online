---
/**
 * Impressum per § 5 DDG — renders only supplied facts (src/data/legal.ts):
 * null → "pending" (and the incompleteness notice), false → item does not apply and is hidden.
 * No link to the EU ODR platform: it was discontinued on 20 July 2025 (Reg. (EU) 2024/3228).
 */
import LegalShell from './LegalShell.astro';
import { business, phones } from '../data/business';
import { legal, legalComplete, type Supplied } from '../data/legal';
import { imprintCopy } from '../i18n/legal-content';
import { type Lang } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = imprintCopy[lang];
const t = useT(lang);
const pending = t.legal.pending;

// Optional items: shown when supplied, "pending" while unknown, hidden when they do not apply.
// `optional: false` = required for this business (no "if applicable" hint while pending).
const optional: { label: string; value: Supplied; optional: boolean }[] = [
  { label: c.representative, value: legal.representative, optional: true },
  { label: c.register, value: legal.register, optional: true },
  { label: c.vat, value: legal.vatId, optional: true },
  { label: c.authority, value: legal.supervisoryAuthority, optional: false },
  { label: c.content, value: legal.contentResponsible, optional: true },
];
---

<LegalShell lang={lang} route="imprint" title={c.title} lede={c.lede} incomplete={!legalComplete()}>
  <dl class="imprint">
    <div>
      <dt>{c.operator}</dt>
      <dd class:list={{ pending: !legal.operatorName }}>{legal.operatorName ?? pending}</dd>
    </div>
    <div>
      <dt>{c.legalForm}</dt>
      <dd class:list={{ pending: !legal.legalForm }}>{legal.legalForm ?? pending}</dd>
    </div>
    <div>
      <dt>{c.address}</dt>
      <dd>
        {
          legal.operatorAddress ? (
            legal.operatorAddress
          ) : (
            <>
              {business.name}
              <br />
              {business.address.street}
              <br />
              {business.address.postalCode} {business.address.city}
              {!legal.addressConfirmed && <span class="note">{c.addressNote}</span>}
            </>
          )
        }
      </dd>
    </div>
    <div>
      <dt>{c.contact}</dt>
      <dd>
        {c.phone}: <a href={phones.landline.href}>{phones.landline.international}</a><br />
        {c.mobile}: <a href={phones.mobile.href}>{phones.mobile.international}</a><br />
        {c.email}:{' '}
        {legal.email ? <a href={`mailto:${legal.email}`}>{legal.email}</a> : <span class="pending">{pending}</span>}
      </dd>
    </div>
    {
      optional
        .filter((o) => o.value !== false)
        .map((o) => (
          <div>
            <dt>
              {o.label} {o.value === null && o.optional && c.ifApplicable}
            </dt>
            <dd class:list={{ pending: o.value === null }}>{o.value ?? pending}</dd>
          </div>
        ))
    }
    {
      legal.consumerDispute !== 'not-applicable' && (
        <div>
          <dt>{c.dispute}</dt>
          <dd class:list={{ pending: legal.consumerDispute === null }}>
            {legal.consumerDispute === 'not-willing' ? c.disputeNotWilling : pending}
          </dd>
        </div>
      )
    }
  </dl>
</LegalShell>

<style>
  .imprint {
    border-top: 1px solid var(--on-paper);
  }
  .imprint > div {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--paper-line);
  }
  @media (min-width: 48em) {
    .imprint > div {
      grid-template-columns: 16rem 1fr;
    }
  }
  .imprint dt {
    font-weight: 600;
  }
  .imprint dd {
    margin: 0;
  }
  .pending {
    color: var(--burgundy);
    font-style: italic;
  }
  .note {
    display: block;
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: var(--burgundy);
  }
</style>
