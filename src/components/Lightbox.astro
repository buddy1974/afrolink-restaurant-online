---
/**
 * One accessible image viewer per page. Any link with `data-lb` opens it:
 *   <a href="<large image>" data-lb data-lb-group="menu" data-lb-title="Egusi Soup"
 *      data-lb-desc="Short text" data-lb-alt="Alt text">…thumbnail…</a>
 *   or data-lb-desc-from="<id>" to take the description from the first paragraph of that element.
 * Links stay real links (the large image) without JavaScript.
 * Previous/next moves within the same group; Escape closes (native <dialog>); swipe on touch;
 * focus returns to the opening link.
 */
import { type Lang } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const t = useT(Astro.props.lang);
---

<dialog class="lightbox" aria-label={t.gallery.viewer} data-lightbox>
  <figure class="lightbox__frame">
    <img class="lightbox__img" alt="" data-lb-img />
    <figcaption class="lightbox__bar">
      <span class="lightbox__text">
        <span class="lightbox__title" data-lb-title></span>
        <span class="lightbox__desc" data-lb-desc></span>
      </span>
      <span class="lightbox__count" data-lb-count></span>
    </figcaption>
  </figure>
  <p class="visually-hidden" aria-live="polite" data-lb-live></p>
  <button class="lb-btn lb-btn--close" type="button" data-lb-close>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M5.5 5.5l13 13M18.5 5.5l-13 13"></path></svg>
    <span class="visually-hidden">{t.gallery.close}</span>
  </button>
  <button class="lb-btn lb-btn--prev" type="button" data-lb-prev>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    <span class="visually-hidden">{t.gallery.prev}</span>
  </button>
  <button class="lb-btn lb-btn--next" type="button" data-lb-next>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
    <span class="visually-hidden">{t.gallery.next}</span>
  </button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog && typeof dialog.showModal === 'function') {
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const title = dialog.querySelector<HTMLElement>('[data-lb-title]')!;
    const desc = dialog.querySelector<HTMLElement>('[data-lb-desc]')!;
    const count = dialog.querySelector<HTMLElement>('[data-lb-count]')!;
    const live = dialog.querySelector<HTMLElement>('[data-lb-live]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-lb-prev]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-lb-next]')!;
    let group: HTMLAnchorElement[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    // Only links that are currently visible take part (e.g. menu search filters some out).
    const members = (name: string) =>
      [...document.querySelectorAll<HTMLAnchorElement>(`a[data-lb][data-lb-group="${CSS.escape(name)}"]`)].filter(
        (a) => !a.closest('[hidden]'),
      );

    const show = (i: number) => {
      index = (i + group.length) % group.length;
      const a = group[index];
      img.src = a.href;
      img.alt = a.dataset.lbAlt ?? '';
      title.textContent = a.dataset.lbTitle ?? '';
      desc.textContent = a.dataset.lbDescFrom
        ? (document.getElementById(a.dataset.lbDescFrom)?.querySelector('p')?.textContent ?? '')
        : (a.dataset.lbDesc ?? '');
      const multi = group.length > 1;
      prev.hidden = !multi;
      next.hidden = !multi;
      count.textContent = multi ? `${index + 1} / ${group.length}` : '';
      live.textContent = [a.dataset.lbTitle, count.textContent].filter(Boolean).join(' – ');
      if (multi) {
        [index + 1, index - 1].forEach((n) => {
          const pre = new Image();
          pre.src = group[(n + group.length) % group.length].href;
        });
      }
    };

    document.addEventListener('click', (ev) => {
      const a = (ev.target as Element | null)?.closest<HTMLAnchorElement>('a[data-lb]');
      if (!a || ev.defaultPrevented || ev.button !== 0 || ev.metaKey || ev.ctrlKey || ev.shiftKey) return;
      ev.preventDefault();
      opener = a;
      group = members(a.dataset.lbGroup ?? 'default');
      if (!group.includes(a)) group = [a];
      show(group.indexOf(a));
      dialog.showModal();
    });
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
      opener?.focus();
    });
    dialog.addEventListener('click', (ev) => {
      if (ev.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (ev) => {
      if (group.length < 2) return;
      if (ev.key === 'ArrowRight') show(index + 1);
      if (ev.key === 'ArrowLeft') show(index - 1);
    });
    let startX = 0;
    let startY = 0;
    dialog.addEventListener(
      'touchstart',
      (ev) => {
        startX = ev.touches[0].clientX;
        startY = ev.touches[0].clientY;
      },
      { passive: true },
    );
    dialog.addEventListener(
      'touchend',
      (ev) => {
        if (group.length < 2) return;
        const dx = ev.changedTouches[0].clientX - startX;
        const dy = ev.changedTouches[0].clientY - startY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) show(index + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(20 17 15 / 0.97);
    color: var(--on-ink);
  }
  .lightbox::backdrop {
    background: rgb(20 17 15 / 0.9);
  }
  .lightbox__frame {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    height: 100%;
    margin: 0;
    padding: 4rem var(--gutter) 1rem;
    pointer-events: none;
  }
  .lightbox__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: auto;
  }
  .lightbox__bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    max-width: 60rem;
    width: 100%;
    margin-inline: auto;
    padding-top: 0.9rem;
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }
  .lightbox__text {
    display: grid;
    gap: 0.2rem;
  }
  .lightbox__title {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--on-ink);
  }
  .lightbox__title:empty,
  .lightbox__desc:empty {
    display: none;
  }
  .lightbox__count {
    flex: none;
    font-variant-numeric: tabular-nums;
  }
  .lb-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    background: rgb(26 22 19 / 0.6);
    border: 1px solid var(--ink-line);
    border-radius: 2px;
    cursor: pointer;
    color: var(--on-ink);
  }
  .lb-btn svg {
    width: 1.4rem;
    height: 1.4rem;
  }
  .lb-btn:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  .lb-btn:focus-visible {
    outline-color: var(--gold);
  }
  .lb-btn--close {
    top: 0.75rem;
    right: var(--gutter);
  }
  .lb-btn--prev,
  .lb-btn--next {
    top: 50%;
    translate: 0 -50%;
  }
  .lb-btn--prev {
    left: max(0.5rem, calc(var(--gutter) / 2));
  }
  .lb-btn--next {
    right: max(0.5rem, calc(var(--gutter) / 2));
  }
</style>
