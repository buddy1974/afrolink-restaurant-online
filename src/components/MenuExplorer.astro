---
/**
 * Image-rich menu (approved design): sticky category tabs + search, dish cards with genuine /
 * owner-supplied photographs or an "Image coming soon" placeholder.
 * Content comes only from src/data (menu.ts, drinks.ts, dish-images.ts).
 */
import { Image, Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Drinks from './Drinks.astro';
import logoMark from '../assets/brand/afrolink-logo.png';
import { foodMenu, type MenuItem } from '../data/menu';
import { drinksMenu } from '../data/drinks';
import { dishImages } from '../data/dish-images';
import { formatPrice } from '../data/format';
import { galleryImage } from '../lib/images';
import { phones, whatsappWithText } from '../data/business';
import { routes, type Lang } from '../i18n/config';
import { fmt, useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const categories = foodMenu
  .map((c) => ({
    ...c,
    items: c.items
      .filter((i: MenuItem) => i.available !== false)
      .map((i) => {
        const di = dishImages[i.id];
        return { ...i, photo: di ? { src: galleryImage(di.file, `dish-images.ts (${i.id})`), alt: di.alt[lang], wm: !!di.watermarked } : null };
      }),
  }))
  .filter((c) => c.items.length > 0);

const hasDrinks = drinksMenu.some((c) => c.items.length > 0);

const searchText = (cat: string, item: MenuItem) =>
  [item.name, item.description?.[lang], item.note?.[lang], item.label?.[lang], cat, ...(item.variants?.map((v) => v.label[lang]) ?? [])]
    .filter(Boolean)
    .join(' ');

const askText = `${t.enquiry.msgGreeting}\n${t.menu.askTitle}\n`;
---

<section class="menu on-paper" id="menu" aria-labelledby="menu-title">
  <div class="wrap menu__head">
    <header class="section-head">
      <p class="eyebrow">{t.menu.eyebrow}</p>
      <h2 id="menu-title" class="section-title">{t.menu.title}</h2>
      <p class="section-lede">{t.menu.lede}</p>
    </header>

    <aside class="notice" aria-label={t.menu.noticeTitle}>
      <p class="notice__title">{t.menu.noticeTitle}</p>
      <ul role="list" class="notice__list">
        <li>{t.menu.noticePork}</li>
        <li>{t.menu.noticeSpice}</li>
        <li>
          {t.menu.noticeAllergens}
          <a href={routes.allergens[lang]}>{t.menu.allergenLink}</a>
          {lang !== 'de' && <a href={routes.allergens.de} lang="de" hreflang="de">(Deutsch)</a>}
        </li>
      </ul>
    </aside>
  </div>

  <div class="menubar" data-menubar>
    <div class="wrap menubar__inner">
      <nav class="menubar__nav" aria-label={t.menu.categories}>
        <ul role="list" class="menubar__list">
          {categories.map((c) => <li><a href={`#${c.id}`}>{c.title[lang]}</a></li>)}
          {hasDrinks && <li class="menubar__drinks"><a href="#drinks">{t.drinks.title}</a></li>}
        </ul>
      </nav>
      <div class="menubar__search" role="search">
        <label class="visually-hidden" for={`menu-search-${lang}`}>{t.menu.searchLabel}</label>
        <svg class="menubar__icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M15 15l5 5" stroke="currentColor" stroke-width="1.6"></path>
        </svg>
        <input
          id={`menu-search-${lang}`}
          type="search"
          autocomplete="off"
          placeholder={t.menu.searchPlaceholder}
          data-menu-search
          data-results={t.menu.results}
        />
        <button type="button" class="menubar__clear" data-menu-clear hidden>
          <span class="visually-hidden">{t.menu.clearSearch}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6"></path></svg>
        </button>
      </div>
    </div>
  </div>
  <p class="visually-hidden" aria-live="polite" data-menu-status></p>

  <div class="wrap menu__body">
    <p class="menu__imgnote">{t.menu.imageNote}</p>
    {
      categories.map((cat, ci) => (
        <section class="mcat" id={cat.id} aria-labelledby={`${cat.id}-title`} data-cat>
          <header class="mcat__head">
            <h3 class="mcat__title" id={`${cat.id}-title`}>
              <span class="mcat__num" aria-hidden="true">
                {String(ci + 1).padStart(2, '0')}
              </span>
              {cat.title[lang]}
            </h3>
            <p class="mcat__count">{cat.items.length === 1 ? t.menu.dishCountOne : fmt(t.menu.dishCount, { n: cat.items.length })}</p>
            {cat.note && <p class="mcat__note">{cat.note[lang]}</p>}
          </header>
          <ul role="list" class="dishes">
            {cat.items.map((item) => (
              <li class="dish" id={`dish-${item.id}`} data-item data-search={searchText(cat.title[lang], item)}>
                <div class="dish__media">
                  {item.photo ? (
                    <Picture
                      src={item.photo.src}
                      formats={['avif', 'webp']}
                      widths={[240, 400, 600, 800]}
                      sizes="(min-width: 80em) 18rem, (min-width: 64em) 30vw, (min-width: 40em) 45vw, 7.5rem"
                      alt={item.photo.alt}
                      loading="lazy"
                      decoding="async"
                      class:list={['dish__img', { 'is-watermarked': item.photo.wm }]}
                    />
                  ) : (
                    <div class="dish__soon">
                      <Image src={logoMark} width={40} densities={[1, 2]} alt="" class="dish__soonlogo" loading="lazy" />
                      <span>{t.menu.imageSoon}</span>
                    </div>
                  )}
                </div>
                <div class="dish__body">
                  {item.variants ? (
                    <>
                      <p class="dish__name">{item.name}</p>
                      <ul role="list" class="variants">
                        {item.variants.map((v) => (
                          <li class="line">
                            <span class="line__name">{v.label[lang]}</span>
                            <span class="line__leader" aria-hidden="true" />
                            <span class="line__price">{formatPrice(v.price)}</span>
                          </li>
                        ))}
                      </ul>
                    </>
                  ) : (
                    <p class="line line--main">
                      <span class="line__name dish__name">{item.name}</span>
                      <span class="line__leader" aria-hidden="true" />
                      <span class="line__price">{formatPrice(item.price!)}</span>
                    </p>
                  )}
                  {item.description && <p class="dish__desc">{item.description[lang]}</p>}
                  {item.note && <p class="dish__note">{item.note[lang]}</p>}
                  {(item.spice || item.label) && (
                    <p class="dish__tags">
                      {item.spice === 'hot' && (
                        <span class="tag tag--hot" title={t.menu.hotTitle}>
                          <span aria-hidden="true">♦</span> {t.menu.hot}
                        </span>
                      )}
                      {item.label && <span class="tag tag--label">{item.label[lang]}</span>}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <Drinks lang={lang} />

  <div class="wrap">
    <p class="noresults" data-menu-empty hidden>{t.menu.noResults}</p>

    <div class="ask">
      <div>
        <p class="ask__title">{t.menu.askTitle}</p>
        <p class="ask__text">{t.menu.askText}</p>
      </div>
      <div class="ask__actions">
        <a class="btn btn--solid" href={whatsappWithText(askText)} target="_blank" rel="noopener">
          <Icon name="whatsapp" /> {t.actions.whatsapp}<span class="visually-hidden"> {t.a11y.opensWhatsApp}</span>
        </a>
        <a class="btn btn--line" href={phones.landline.href}><Icon name="phone" /> {phones.landline.display}</a>
        <a class="btn btn--line" href="#enquiry" data-enquiry="dietary">{t.dietary.cta}</a>
      </div>
    </div>
    <p class="desc-source">{t.menu.descSource}</p>
  </div>
</section>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-menu-search]');
  const clear = document.querySelector<HTMLButtonElement>('[data-menu-clear]');
  const status = document.querySelector<HTMLElement>('[data-menu-status]');
  const empty = document.querySelector<HTMLElement>('[data-menu-empty]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
  const cats = [...document.querySelectorAll<HTMLElement>('[data-cat]')];

  const norm = (s: string) =>
    s
      .toLowerCase()
      .normalize('NFD')
      .replace(/\p{Diacritic}/gu, '');
  const index = items.map((el) => norm(el.dataset.search ?? el.textContent ?? ''));

  let timer: number | undefined;
  function apply() {
    const q = norm(input?.value.trim() ?? '');
    let shown = 0;
    items.forEach((el, i) => {
      const match = !q || q.split(/\s+/).every((w) => index[i].includes(w));
      el.hidden = !match;
      if (match) shown++;
    });
    cats.forEach((c) => {
      c.hidden = !!q && !c.querySelector('[data-item]:not([hidden])');
    });
    const drinks = document.getElementById('drinks');
    if (drinks) drinks.hidden = !!q && !drinks.querySelector('[data-item]:not([hidden])');
    if (clear) clear.hidden = !q;
    if (empty) empty.hidden = !q || shown > 0;
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      if (status) status.textContent = q ? (input?.dataset.results ?? '{n}').replace('{n}', String(shown)) : '';
    }, 400);
  }
  input?.addEventListener('input', apply);
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && input.value) {
      input.value = '';
      apply();
    }
  });
  clear?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    apply();
    input.focus();
  });

  // Category tabs: highlight the category in view; keep the active tab visible.
  const bar = document.querySelector<HTMLElement>('[data-menubar]');
  const links = bar ? [...bar.querySelectorAll<HTMLAnchorElement>('.menubar__list a')] : [];
  const targets = links.map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!)).filter((x): x is HTMLElement => !!x);
  let current: HTMLAnchorElement | undefined;
  function activate(id: string) {
    const link = links.find((a) => a.getAttribute('href') === `#${id}`);
    if (!link || link === current) return;
    current?.removeAttribute('aria-current');
    link.setAttribute('aria-current', 'true');
    current = link;
    const list = link.closest('ul');
    if (list && list.scrollWidth > list.clientWidth) list.scrollTo({ left: link.offsetLeft - 16, behavior: 'smooth' });
  }
  if (targets.length && 'IntersectionObserver' in window) {
    const visible = new Map<string, boolean>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => visible.set(e.target.id, e.isIntersecting));
        const first = targets.find((t) => visible.get(t.id));
        if (first) activate(first.id);
      },
      { rootMargin: '-35% 0px -55% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  .menu {
    padding-top: var(--section);
  }
  .menu__head {
    display: grid;
    gap: 2rem;
    align-items: end;
    padding-bottom: 2rem;
  }
  .menu__head .section-head {
    margin-bottom: 0;
  }
  @media (min-width: 64em) {
    .menu__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
  .notice {
    padding: 1.25rem 1.4rem;
    background: var(--paper-sunk);
    border-left: 3px solid var(--gold);
  }
  .notice__title {
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .notice__list {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  @media (min-width: 48em) {
    .notice__list {
      font-size: var(--step-0);
    }
  }
  .notice__list a {
    font-weight: 600;
    margin-left: 0.25rem;
    color: var(--gold);
  }

  /* ---------- sticky category tabs + search ---------- */
  .menubar {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    background: var(--ink);
    border-top: 1px solid var(--paper-line);
    border-bottom: 1px solid var(--paper-line);
  }
  .menubar__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }
  .menubar__inner > * {
    min-width: 0;
  }
  @media (min-width: 64em) {
    .menubar__inner {
      grid-template-columns: minmax(0, 1fr) 19rem;
      align-items: center;
      gap: 2rem;
    }
  }
  .menubar__list {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding: 0.55rem var(--gutter);
  }
  @media (min-width: 64em) {
    .menubar__list {
      margin-inline: 0;
      padding-inline: 0;
    }
  }
  .menubar__list::-webkit-scrollbar {
    display: none;
  }
  .menubar__list a {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.95rem;
    white-space: nowrap;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--on-paper-muted);
    border: 1px solid var(--paper-line);
    border-radius: 999px;
  }
  .menubar__list a:hover {
    color: var(--on-paper);
    border-color: var(--gold);
  }
  .menubar__list a[aria-current] {
    color: var(--ink);
    background: var(--gold);
    border-color: var(--gold);
  }
  .menubar__drinks a {
    color: var(--gold);
    border-color: rgb(214 168 78 / 0.5);
  }
  .menubar__search {
    position: relative;
    display: flex;
    align-items: center;
    padding-bottom: 0.6rem;
  }
  @media (min-width: 64em) {
    .menubar__search {
      padding-bottom: 0;
    }
  }
  .menubar__icon {
    position: absolute;
    left: 0.75rem;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--on-paper-muted);
    pointer-events: none;
  }
  .menubar__search input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 2.75rem 0.5rem 2.4rem;
    font: inherit;
    font-size: 1rem;
    color: var(--on-paper);
    background: var(--field);
    border: 1px solid var(--paper-line);
    border-radius: 999px;
  }
  .menubar__search input::placeholder {
    color: var(--on-paper-muted);
  }
  .menubar__search input:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }
  .menubar__search input::-webkit-search-cancel-button {
    display: none;
  }
  .menubar__clear {
    position: absolute;
    right: 0.25rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    background: none;
    color: var(--on-paper-muted);
    cursor: pointer;
  }
  .menubar__clear svg {
    width: 1rem;
    height: 1rem;
  }

  /* ---------- categories & dish cards ---------- */
  .menu__body {
    display: grid;
    gap: clamp(3rem, 2rem + 3vw, 5rem);
    padding-block: clamp(2rem, 1.5rem + 2vw, 3rem) clamp(3rem, 2rem + 3vw, 5rem);
  }
  .menu__imgnote {
    font-size: var(--step--1);
    color: var(--on-paper-muted);
  }
  .mcat {
    scroll-margin-top: calc(var(--header-h) + 8.5rem);
  }
  @media (min-width: 64em) {
    .mcat {
      scroll-margin-top: calc(var(--header-h) + 5rem);
    }
  }
  .mcat__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    padding-bottom: 0.9rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgb(214 168 78 / 0.55);
  }
  .mcat__title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.1;
  }
  .mcat__num {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--gold);
  }
  .mcat__count {
    font-size: var(--step--1);
    color: var(--on-paper-muted);
  }
  .mcat__note {
    flex-basis: 100%;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--gold);
  }

  .dishes {
    display: grid;
    gap: 0.75rem;
  }
  @media (min-width: 40em) {
    .dishes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }
  @media (min-width: 64em) {
    .dishes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 80em) {
    .dishes {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .dish {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.9rem;
    padding: 0.6rem;
    background: var(--ink-raised);
    border: 1px solid var(--paper-line);
  }
  @media (min-width: 40em) {
    .dish {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      gap: 0;
      padding: 0;
    }
  }
  .dish__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--paper-sunk);
  }
  @media (max-width: 39.99em) {
    .dish__media {
      aspect-ratio: 1 / 1;
      align-self: start;
    }
  }
  .dish__media :global(picture),
  .dish__img {
    width: 100%;
    height: 100%;
  }
  .dish__img {
    object-fit: cover;
  }
  .dish__img.is-watermarked {
    object-position: 100% 100%;
  }
  .dish__soon {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.4rem;
    height: 100%;
    padding: 0.5rem;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--on-paper-muted);
    border: 1px dashed rgb(214 168 78 / 0.35);
  }
  .dish__soonlogo {
    width: 2.5rem;
    height: auto;
    opacity: 0.55;
    filter: grayscale(0.4);
  }
  .dish__body {
    display: grid;
    align-content: start;
    gap: 0.3rem;
    min-width: 0;
  }
  @media (min-width: 40em) {
    .dish__body {
      padding: 1rem 1.1rem 1.15rem;
    }
  }
  .line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .dish__name {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.25;
  }
  .line__name {
    min-width: 0;
  }
  .line__leader {
    flex: 1 1 1rem;
    min-width: 1rem;
    border-bottom: 1px dotted rgb(243 237 227 / 0.28);
    transform: translateY(-0.3em);
  }
  .line__price {
    flex: none;
    font-size: var(--step-1);
    font-weight: 700;
    font-variant-numeric: tabular-nums lining-nums;
    color: var(--gold);
  }
  .variants {
    display: grid;
    gap: 0.2rem;
  }
  .variants .line__name {
    color: var(--on-paper-muted);
  }
  .variants .line__price {
    font-size: var(--step-0);
  }
  .dish__desc {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--on-paper-muted);
  }
  .dish__note {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--on-paper-muted);
  }
  .dish__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.2rem;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid currentColor;
  }
  .tag--hot {
    color: var(--gold);
  }
  .tag--label {
    color: var(--burgundy);
  }

  .noresults {
    margin-block: 0 2rem;
    padding: 1.25rem;
    background: var(--paper-sunk);
    font-size: var(--step-1);
  }
  .ask {
    display: grid;
    gap: 1.25rem;
    margin-block: clamp(2.5rem, 2rem + 2vw, 4rem) 0;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border: 1px solid rgb(214 168 78 / 0.55);
  }
  @media (min-width: 64em) {
    .ask {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }
  .ask__title {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.2;
  }
  .ask__text {
    margin-top: 0.25rem;
    color: var(--on-paper-muted);
  }
  .ask__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .desc-source {
    margin-block: 1rem var(--section);
    font-size: var(--step--1);
    color: var(--on-paper-muted);
  }
</style>
