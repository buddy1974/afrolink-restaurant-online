---
/**
 * Interactive menu: sticky category bar + search, one row per category (photo beside list).
 * Content comes only from src/data/menu.ts and drinks.ts — no presentation edits needed for updates.
 */
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import Drinks from './Drinks.astro';
import { foodMenu, type MenuItem } from '../data/menu';
import { drinksMenu } from '../data/drinks';
import { formatPrice } from '../data/format';
import { galleryImage } from '../lib/images';
import { phones, whatsappWithText } from '../data/business';
import { routes, type Lang } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const categories = foodMenu
  .map((c) => ({
    ...c,
    items: c.items.filter((i: MenuItem) => i.available !== false),
    photo: c.image
      ? (() => {
          const src = galleryImage(c.image.file, `menu.ts (${c.id})`);
          // Only watermarked portrait photos need the uncropped mat; others fill the frame.
          return { src, alt: c.image.alt[lang], wm: !!c.image.watermarked, portrait: !!c.image.watermarked && src.height > src.width };
        })()
      : null,
  }))
  .filter((c) => c.items.length > 0);

const hasDrinks = drinksMenu.some((c) => c.items.length > 0);

const searchText = (cat: string, item: MenuItem) =>
  [item.name, item.description?.[lang], item.note?.[lang], item.label?.[lang], cat, ...(item.variants?.map((v) => v.label[lang]) ?? [])]
    .filter(Boolean)
    .join(' ');

const askText = `${t.enquiry.msgGreeting}\n${t.menu.askTitle}\n`;
---

<section class="menu on-paper" id="menu" aria-labelledby="menu-title">
  <div class="wrap menu__head">
    <header class="section-head">
      <p class="eyebrow">{t.menu.eyebrow}</p>
      <h2 id="menu-title" class="section-title">{t.menu.title}</h2>
      <p class="section-lede">{t.menu.lede}</p>
    </header>

    <aside class="notice" aria-label={t.menu.noticeTitle}>
      <p class="notice__title">{t.menu.noticeTitle}</p>
      <ul role="list" class="notice__list">
        <li>{t.menu.noticePork}</li>
        <li>{t.menu.noticeSpice}</li>
        <li>
          {t.menu.noticeAllergens}
          <a href={routes.allergens[lang]}>{t.menu.allergenLink}</a>
          {lang !== 'de' && <a href={routes.allergens.de} lang="de" hreflang="de">(Deutsch)</a>}
        </li>
      </ul>
    </aside>
  </div>

  <div class="menubar" data-menubar>
    <div class="wrap menubar__inner">
      <nav class="menubar__nav" aria-label={t.menu.categories}>
        <ul role="list" class="menubar__list">
          {categories.map((c) => <li><a href={`#${c.id}`}>{c.title[lang]}</a></li>)}
          {hasDrinks && <li class="menubar__drinks"><a href="#drinks">{t.drinks.title}</a></li>}
        </ul>
      </nav>
      <div class="menubar__search" role="search">
        <label class="visually-hidden" for={`menu-search-${lang}`}>{t.menu.searchLabel}</label>
        <svg class="menubar__icon" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <path d="M15 15l5 5" stroke="currentColor" stroke-width="1.6"></path>
        </svg>
        <input
          id={`menu-search-${lang}`}
          type="search"
          autocomplete="off"
          placeholder={t.menu.searchPlaceholder}
          data-menu-search
          data-results={t.menu.results}
        />
        <button type="button" class="menubar__clear" data-menu-clear hidden>
          <span class="visually-hidden">{t.menu.clearSearch}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6"></path></svg>
        </button>
      </div>
    </div>
  </div>
  <p class="visually-hidden" aria-live="polite" data-menu-status></p>

  <div class="wrap menu__body">
    {
      categories.map((cat, ci) => (
        <section
          class:list={['mcat', { 'mcat--photo': cat.photo, 'mcat--long': cat.items.length > 6 }]}
          id={cat.id}
          aria-labelledby={`${cat.id}-title`}
          data-cat
        >
          {cat.photo && (
            <div class="mcat__media">
              <Picture
                src={cat.photo.src}
                formats={['avif', 'webp']}
                widths={[400, 640, 900]}
                sizes="(min-width: 56em) 30rem, 100vw"
                alt={cat.photo.alt}
                loading="lazy"
                decoding="async"
                class:list={['mcat__img', { 'is-watermarked': cat.photo.wm, 'is-portrait': cat.photo.portrait }]}
              />
            </div>
          )}
          <div class="mcat__content">
            <h3 class="mcat__title" id={`${cat.id}-title`}>
              <span class="mcat__num" aria-hidden="true">{String(ci + 1).padStart(2, '0')}</span>
              {cat.title[lang]}
            </h3>
            <ul role="list" class="items">
              {cat.items.map((item) => (
                <li class="item" id={`dish-${item.id}`} data-item data-search={searchText(cat.title[lang], item)}>
                  {item.variants ? (
                    <>
                      <p class="line">
                        <span class="line__name item__name">{item.name}</span>
                      </p>
                      <ul role="list" class="variants">
                        {item.variants.map((v) => (
                          <li class="line line--variant">
                            <span class="line__name">{v.label[lang]}</span>
                            <span class="line__leader" aria-hidden="true" />
                            <span class="line__price">{formatPrice(v.price)}</span>
                          </li>
                        ))}
                      </ul>
                    </>
                  ) : (
                    <p class="line">
                      <span class="line__name item__name">{item.name}</span>
                      <span class="line__leader" aria-hidden="true" />
                      <span class="line__price">{formatPrice(item.price!)}</span>
                    </p>
                  )}
                  {item.description && <p class="item__desc">{item.description[lang]}</p>}
                  {item.note && <p class="item__note">{item.note[lang]}</p>}
                  {(item.spice || item.label) && (
                    <p class="item__tags">
                      {item.spice === 'hot' && (
                        <span class="tag tag--hot" title={t.menu.hotTitle}>
                          <span aria-hidden="true">♦</span> {t.menu.hot}
                        </span>
                      )}
                      {item.label && <span class="tag tag--label">{item.label[lang]}</span>}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }
  </div>

  <Drinks lang={lang} />

  <div class="wrap">
    <p class="noresults" data-menu-empty hidden>{t.menu.noResults}</p>

    <div class="ask">
      <div>
        <p class="ask__title">{t.menu.askTitle}</p>
        <p class="ask__text">{t.menu.askText}</p>
      </div>
      <div class="ask__actions">
        <a class="btn btn--solid" href={whatsappWithText(askText)} target="_blank" rel="noopener">
          <Icon name="whatsapp" /> {t.actions.whatsapp}<span class="visually-hidden"> {t.a11y.opensWhatsApp}</span>
        </a>
        <a class="btn btn--line" href={phones.landline.href}><Icon name="phone" /> {phones.landline.display}</a>
        <a class="btn btn--line" href="#enquiry" data-enquiry="dietary">{t.dietary.cta}</a>
      </div>
    </div>
    <p class="desc-source">{t.menu.descSource}</p>
  </div>
</section>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-menu-search]');
  const clear = document.querySelector<HTMLButtonElement>('[data-menu-clear]');
  const status = document.querySelector<HTMLElement>('[data-menu-status]');
  const empty = document.querySelector<HTMLElement>('[data-menu-empty]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
  const cats = [...document.querySelectorAll<HTMLElement>('[data-cat]')];

  const norm = (s: string) =>
    s
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '');
  const index = items.map((el) => norm(el.dataset.search ?? el.textContent ?? ''));

  let timer: number | undefined;
  function apply() {
    const q = norm(input?.value.trim() ?? '');
    let shown = 0;
    items.forEach((el, i) => {
      const match = !q || q.split(/\s+/).every((w) => index[i].includes(w));
      el.hidden = !match;
      if (match) shown++;
    });
    cats.forEach((c) => {
      c.hidden = !!q && !c.querySelector('[data-item]:not([hidden])');
    });
    const drinks = document.getElementById('drinks');
    if (drinks) drinks.hidden = !!q && !drinks.querySelector('[data-item]:not([hidden])');
    if (clear) clear.hidden = !q;
    if (empty) empty.hidden = !q || shown > 0;
    window.clearTimeout(timer);
    timer = window.setTimeout(() => {
      if (status) status.textContent = q ? (input?.dataset.results ?? '{n}').replace('{n}', String(shown)) : '';
    }, 400);
  }
  input?.addEventListener('input', apply);
  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && input.value) {
      input.value = '';
      apply();
    }
  });
  clear?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    apply();
    input.focus();
  });

  // Category bar: highlight the category in view; keep the active chip visible.
  const bar = document.querySelector<HTMLElement>('[data-menubar]');
  const links = bar ? [...bar.querySelectorAll<HTMLAnchorElement>('.menubar__list a')] : [];
  const targets = links.map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!)).filter((x): x is HTMLElement => !!x);
  let current: HTMLAnchorElement | undefined;
  function activate(id: string) {
    const link = links.find((a) => a.getAttribute('href') === `#${id}`);
    if (!link || link === current) return;
    current?.removeAttribute('aria-current');
    link.setAttribute('aria-current', 'true');
    current = link;
    const list = link.closest('ul');
    if (list && list.scrollWidth > list.clientWidth) list.scrollTo({ left: link.offsetLeft - 16, behavior: 'smooth' });
  }
  if (targets.length && 'IntersectionObserver' in window) {
    const visible = new Map<string, boolean>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => visible.set(e.target.id, e.isIntersecting));
        const first = targets.find((t) => visible.get(t.id));
        if (first) activate(first.id);
      },
      { rootMargin: '-35% 0px -55% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  .menu {
    padding-top: var(--section);
  }
  .menu__head {
    display: grid;
    gap: 2rem;
    align-items: end;
    padding-bottom: 2rem;
  }
  .menu__head .section-head {
    margin-bottom: 0;
  }
  @media (min-width: 64em) {
    .menu__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }

  .notice {
    padding: 1.25rem 1.4rem;
    background: var(--paper-sunk);
    border-left: 3px solid var(--terracotta);
  }
  .notice__title {
    font-size: var(--step--1);
    font-weight: 650;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  .notice__list {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  @media (min-width: 48em) {
    .notice__list {
      font-size: var(--step-0);
    }
  }
  .notice__list a {
    font-weight: 600;
    margin-left: 0.25rem;
  }

  /* ---------- sticky category bar ---------- */
  .menubar {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    background: var(--paper);
    border-top: 1px solid var(--paper-line);
    border-bottom: 1px solid var(--paper-line);
  }
  .menubar__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }
  .menubar__inner > * {
    min-width: 0;
  }
  @media (min-width: 64em) {
    .menubar__inner {
      grid-template-columns: minmax(0, 1fr) 19rem;
      align-items: center;
      gap: 2rem;
    }
  }
  .menubar__list {
    display: flex;
    gap: 0.25rem 1.4rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }
  @media (min-width: 64em) {
    .menubar__list {
      margin-inline: 0;
      padding-inline: 0;
    }
  }
  .menubar__list::-webkit-scrollbar {
    display: none;
  }
  .menubar__list a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    white-space: nowrap;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--on-paper-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .menubar__list a:hover {
    color: var(--on-paper);
  }
  .menubar__list a[aria-current] {
    color: var(--on-paper);
    border-bottom-color: var(--terracotta);
  }
  .menubar__drinks {
    padding-left: 1.4rem;
    border-left: 1px solid var(--paper-line);
  }
  .menubar__drinks a {
    color: var(--terracotta);
  }

  .menubar__search {
    position: relative;
    display: flex;
    align-items: center;
    padding-bottom: 0.6rem;
  }
  @media (min-width: 64em) {
    .menubar__search {
      padding-bottom: 0;
    }
  }
  .menubar__icon {
    position: absolute;
    left: 0.75rem;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--on-paper-muted);
    pointer-events: none;
  }
  .menubar__search input {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 2.75rem 0.5rem 2.4rem;
    font: inherit;
    font-size: 1rem;
    color: var(--on-paper);
    background: #fffdf8;
    border: 1px solid var(--paper-line);
    border-radius: 2px;
  }
  .menubar__search input::placeholder {
    color: var(--on-paper-muted);
  }
  .menubar__search input:focus-visible {
    outline: 2px solid var(--terracotta);
    outline-offset: 1px;
  }
  .menubar__search input::-webkit-search-cancel-button {
    display: none;
  }
  .menubar__clear {
    position: absolute;
    right: 0.25rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    background: none;
    color: var(--on-paper-muted);
    cursor: pointer;
  }
  .menubar__clear svg {
    width: 1rem;
    height: 1rem;
  }

  /* ---------- categories ---------- */
  .menu__body {
    display: grid;
    gap: clamp(3rem, 2rem + 3vw, 5rem);
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem) clamp(3rem, 2rem + 3vw, 5rem);
  }
  .mcat {
    display: grid;
    gap: 1.25rem;
    /* header + two-row category bar on phones; one row from 64em */
    scroll-margin-top: calc(var(--header-h) + 8.5rem);
  }
  @media (min-width: 64em) {
    .mcat {
      scroll-margin-top: calc(var(--header-h) + 5rem);
    }
  }
  .mcat[hidden] {
    display: none;
  }
  @media (min-width: 56em) {
    .mcat--photo {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2rem, 1rem + 3vw, 4rem);
      align-items: start;
    }
    .mcat__media {
      position: sticky;
      top: calc(var(--header-h) + 4.5rem);
    }
  }
  @media (min-width: 75em) {
    .mcat--photo {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
    .mcat--long .items {
      columns: 2;
      column-gap: 2.5rem;
    }
    .mcat--long .item {
      break-inside: avoid;
    }
  }

  .mcat__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 40%;
    background: var(--paper-sunk);
  }
  .mcat__img.is-watermarked {
    object-position: 100% 100%;
  }
  .mcat__img.is-portrait {
    /* portrait photos are shown whole on a paper mat — neither the dish nor the watermark is cropped */
    object-fit: contain;
    object-position: 50% 50%;
    padding: 0.75rem;
  }
  @media (min-width: 56em) {
    .mcat__img {
      aspect-ratio: 1 / 1;
    }
    /* desktop: a 3:4 frame matches the 3:4 photos exactly — whole image, no mat, no crop */
    .mcat__img.is-portrait {
      aspect-ratio: 3 / 4;
      padding: 0;
    }
  }

  .mcat__title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    margin-bottom: 0.25rem;
    border-bottom: 1px solid var(--on-paper);
    font-family: var(--font-serif);
    font-size: var(--step-3);
    font-weight: 400;
    line-height: 1.1;
  }
  .mcat__num {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--terracotta);
    font-variant-numeric: tabular-nums;
  }

  .item {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--paper-line);
  }
  .item[hidden] {
    display: none;
  }
  .line {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }
  .item__name {
    font-size: var(--step-1);
    font-weight: 550;
    line-height: 1.3;
  }
  .line__name {
    min-width: 0;
  }
  .line__leader {
    flex: 1 1 1.5rem;
    min-width: 1.5rem;
    border-bottom: 1px dotted rgb(31 26 22 / 0.35);
    transform: translateY(-0.3em);
  }
  .line__price {
    flex: none;
    font-size: var(--step-1);
    font-weight: 650;
    font-variant-numeric: tabular-nums lining-nums;
    min-width: 2.6em;
    text-align: right;
  }
  .variants {
    margin-top: 0.3rem;
    padding-left: 1rem;
    border-left: 1px solid var(--paper-line);
  }
  .line--variant {
    padding-block: 0.15rem;
  }
  .line--variant .line__name {
    color: var(--on-paper-muted);
  }
  .item__desc {
    margin-top: 0.2rem;
    font-size: var(--step-0);
    line-height: 1.45;
    color: var(--on-paper-muted);
  }
  .item__note {
    margin-top: 0.2rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--step-0);
    color: var(--on-paper-muted);
  }
  .item__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid currentColor;
  }
  .tag--hot {
    color: var(--terracotta);
  }
  .tag--label {
    color: var(--burgundy);
  }

  .noresults {
    margin-block: 0 2rem;
    padding: 1.25rem;
    background: var(--paper-sunk);
    font-size: var(--step-1);
  }

  .ask {
    display: grid;
    gap: 1.25rem;
    margin-block: clamp(2.5rem, 2rem + 2vw, 4rem) 0;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border: 1px solid var(--on-paper);
  }
  @media (min-width: 64em) {
    .ask {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
    }
  }
  .ask__title {
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.2;
  }
  .ask__text {
    margin-top: 0.25rem;
    color: var(--on-paper-muted);
  }
  .ask__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .desc-source {
    margin-block: 1rem var(--section);
    font-size: var(--step--1);
    color: var(--on-paper-muted);
  }
</style>
