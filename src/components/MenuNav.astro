---
/** Sticky category selector spanning the food and drinks menus. */
import { foodMenu } from '../data/menu';

const links = [
  ...foodMenu.filter((c) => c.items.some((i) => i.available !== false)).map((c) => ({ href: `#${c.id}`, label: c.title })),
  { href: '#drinks', label: 'Drinks' },
];
---

<nav class="menu-nav" aria-label="Menu categories" data-menu-nav>
  <div class="wrap">
    <ul role="list" class="menu-nav__list">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </div>
</nav>

<script>
  // Scroll-spy: mark the category currently in view; keep the active tab visible.
  const nav = document.querySelector<HTMLElement>('[data-menu-nav]');
  const links = nav ? [...nav.querySelectorAll<HTMLAnchorElement>('a')] : [];
  const targets = links
    .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href')!))
    .filter((el): el is HTMLElement => !!el);

  let current: HTMLAnchorElement | undefined;
  function activate(id: string) {
    const link = links.find((a) => a.getAttribute('href') === `#${id}`);
    if (!link || link === current) return;
    current?.removeAttribute('aria-current');
    link.setAttribute('aria-current', 'true');
    current = link;
    const list = link.closest('ul');
    if (list && list.scrollWidth > list.clientWidth) {
      list.scrollTo({ left: link.offsetLeft - 16, behavior: 'smooth' });
    }
  }

  if (targets.length && 'IntersectionObserver' in window) {
    const visible = new Map<string, boolean>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => visible.set(e.target.id, e.isIntersecting));
        const first = targets.find((t) => visible.get(t.id));
        if (first) activate(first.id);
      },
      { rootMargin: '-30% 0px -60% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  .menu-nav {
    position: sticky;
    top: var(--header-h);
    z-index: 40;
    background: var(--paper);
    border-bottom: 1px solid var(--paper-line);
  }
  .menu-nav__list {
    display: flex;
    gap: 0.25rem 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
  }
  .menu-nav__list::-webkit-scrollbar {
    display: none;
  }
  .menu-nav a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    white-space: nowrap;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--on-paper-muted);
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
  }
  .menu-nav a:hover {
    color: var(--on-paper);
  }
  .menu-nav a[aria-current] {
    color: var(--on-paper);
    border-bottom-color: var(--terracotta);
  }
  .menu-nav li:last-child {
    margin-left: auto;
    padding-left: 1.5rem;
    border-left: 1px solid var(--paper-line);
  }
  .menu-nav li:last-child a {
    color: var(--terracotta);
  }
  @media (min-width: 64em) {
    .menu-nav__list {
      margin-inline: 0;
      padding-inline: 0;
    }
  }
</style>
