---
/**
 * Layout for the dedicated discovery pages (menu, soups, dishes, services, gallery, contact):
 * header, visible breadcrumb trail (+ BreadcrumbList JSON-LD), a page header with the h1,
 * the page content, and the footer.
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { breadcrumbJsonLd, webPageJsonLd, type Crumb } from '../data/seo';
import { routes, type Lang, type Paths, type RouteKey } from '../i18n/config';
import { usePages } from '../i18n/pages';

interface Props {
  lang: Lang;
  route: RouteKey;
  paths?: Paths;
  title: string;
  description: string;
  /** Trail after "Home" (last item = this page). */
  crumbs: Crumb[];
  h1?: string;
  eyebrow?: string;
  lede?: string;
  jsonLd?: object[];
  image?: { url: string; width: number; height: number; alt: string };
  /** Hide the standard page header (the page renders its own h1). */
  bare?: boolean;
}
const { lang, route, title, description, crumbs, h1, eyebrow, lede, jsonLd = [], image, bare = false } = Astro.props;
const paths = Astro.props.paths ?? routes[route];
const p = usePages(lang);
const trail: Crumb[] = [{ name: p.nav.home, href: routes.home[lang] }, ...crumbs];
const ld = [webPageJsonLd(lang, paths[lang], title, description), breadcrumbJsonLd(trail), ...jsonLd];
---

<Base lang={lang} route={route} paths={paths} title={title} description={description} jsonLd={ld} image={image}>
  <Header lang={lang} route={route} paths={paths} />
  <main id="main" class="page on-paper">
    <nav class="crumbs wrap" aria-label={p.nav.breadcrumb}>
      <ol>
        {
          trail.map((c, i) => (
            <li>
              {i < trail.length - 1 ? (
                <a href={c.href}>{c.name}</a>
              ) : (
                <span aria-current="page">{c.name}</span>
              )}
            </li>
          ))
        }
      </ol>
    </nav>
    {
      !bare && (
        <header class="page__head wrap">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          <h1 class="page__title">{h1}</h1>
          {lede && <p class="page__lede">{lede}</p>}
        </header>
      )
    }
    <slot />
  </main>
  <Footer lang={lang} route={route} paths={paths} />
</Base>

<style>
  .page {
    padding-bottom: var(--section);
  }
  .crumbs {
    padding-block: 1.1rem 0;
    font-size: var(--step--1);
    color: var(--on-paper-muted);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: rgb(214 168 78 / 0.6);
  }
  .crumbs a {
    color: var(--on-paper-muted);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--gold);
    text-decoration: underline;
  }
  .crumbs [aria-current] {
    color: var(--on-paper);
  }
  .page__head {
    display: grid;
    gap: 0.6rem;
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .page__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--step-5, var(--step-4));
    line-height: 1.05;
  }
  .page__lede {
    max-width: 44rem;
    font-size: var(--step-1);
    color: var(--on-paper-muted);
  }
</style>
