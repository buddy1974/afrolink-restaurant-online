---
/**
 * Customer rating UI (progressive enhancement). Static pages contain empty, hidden
 * `[data-rating-slot]` elements; this script asks /api/ratings whether ratings are enabled and,
 * only then, shows averages, counts and a 1–5 star form (radio group: keyboard and screen-reader
 * friendly). Nothing is shown — no placeholder stars — while ratings are disabled or unavailable.
 */
import { type Lang } from '../i18n/config';
import { usePages } from '../i18n/pages';
import { useConsentUi } from '../i18n/consent';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const r = usePages(lang).rating;
const strings = JSON.stringify({ ...r, remember: useConsentUi(lang).rating.remember, locale: lang === 'en' ? 'en-GB' : lang });
---

<script type="application/json" data-rating-i18n set:html={strings} />

<script>
  // Ratings sit below the fold: load the client only when the browser is idle.
  if (document.querySelector('[data-rating-slot], [data-ratings-discover]')) {
    const load = () => import('../lib/ratings/client').then((m) => m.start());
    if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 4000 });
    else setTimeout(load, 2000);
  }
</script>

<style is:global>
  .rt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    font-size: 0.875rem;
    color: var(--on-paper-muted);
  }
  .rt__stars {
    --v: 0%;
    position: relative;
    display: inline-block;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    line-height: 1;
    color: rgb(243 237 227 / 0.22);
  }
  .rt__stars::before {
    content: '★★★★★';
  }
  .rt__stars::after {
    content: '★★★★★';
    position: absolute;
    inset: 0;
    width: var(--v);
    overflow: hidden;
    color: var(--gold);
  }
  .rt__stars[hidden] {
    display: none;
  }
  .rt__btn {
    min-height: 2rem;
    padding: 0.1rem 0.6rem;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--gold);
    background: transparent;
    border: 1px solid rgb(214 168 78 / 0.5);
    border-radius: 999px;
    cursor: pointer;
  }
  .rt__btn[aria-expanded='true'] {
    color: var(--ink);
    background: var(--gold);
  }
  .rt__form {
    min-width: 0;
    display: grid;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.75rem 0.9rem;
    background: var(--paper-sunk);
    border-left: 2px solid var(--gold);
  }
  .rt__form fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .rt__legend {
    padding: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--on-paper);
  }
  .rt__pick {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem;
    margin-top: 0.3rem;
  }
  .rt__star {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.6rem;
    font-size: 1.5rem;
    line-height: 1;
    color: rgb(243 237 227 / 0.3);
    cursor: pointer;
  }
  /* Narrow menu cards (photo beside text): keep all five stars on one line. */
  @media (max-width: 39.99em) {
    .dish .rt__form {
      padding: 0.65rem 0.6rem;
    }
    .dish .rt__star {
      width: 1.85rem;
      height: 2.5rem;
      font-size: 1.35rem;
    }
  }
  .rt__star.is-on {
    color: var(--gold);
  }
  .rt__star:focus-within {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
  }
  .rt__remember {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--on-paper-muted);
    cursor: pointer;
  }
  .rt__remember input {
    flex: none;
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.05rem;
    accent-color: var(--gold);
  }
  .rt__hp {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .rt__submit {
    justify-self: start;
    min-height: 2.5rem;
    padding: 0.3rem 1rem;
    font: inherit;
    font-weight: 650;
    color: var(--ink);
    background: var(--gold);
    border: 1px solid var(--gold);
    cursor: pointer;
  }
  .rt__submit:disabled {
    opacity: 0.6;
  }
  .rt__msg {
    font-weight: 600;
    color: var(--on-paper);
  }
  .rt__msg:empty {
    display: none;
  }
  .rt__note {
    font-size: 0.8125rem;
    color: var(--on-paper-muted);
  }
</style>
