---
/** Reservation CTA. Afrolink accepts reservations by phone; contact data from business.ts. */
import Icon from './Icon.astro';
import Rule from './Rule.astro';
import { phones, whatsapp } from '../data/business';
---

<section class="reserve on-paper" aria-labelledby="reserve-title">
  <div class="wrap reserve__inner">
    <div class="reserve__text">
      <p class="eyebrow">Reservations accepted</p>
      <h2 id="reserve-title" class="reserve__title">Book a table</h2>
      <p class="reserve__p">Call us to reserve — for two, for the family or for a celebration.</p>
    </div>
    <div class="reserve__actions">
      <a class="btn btn--solid" href={phones.landline.href}>
        <Icon name="phone" /> Call {phones.landline.display}
      </a>
      <a class="btn btn--line" href={whatsapp.href} target="_blank" rel="noopener">
        <Icon name="whatsapp" /> WhatsApp<span class="visually-hidden"> (opens WhatsApp)</span>
      </a>
      <a class="reserve__alt" href={phones.mobile.href}>or mobile {phones.mobile.display}</a>
    </div>
  </div>
  <div class="wrap"><Rule align="center" /></div>
</section>

<style>
  .reserve {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) 0;
  }
  .reserve__inner {
    display: grid;
    gap: 1.75rem;
    align-items: end;
    padding-bottom: clamp(3rem, 2rem + 4vw, 5rem);
  }
  @media (min-width: 56em) {
    .reserve__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
    }
  }
  .reserve__title {
    margin-top: 0.6rem;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--step-4);
    line-height: 1.05;
  }
  .reserve__p {
    max-width: 30rem;
    margin-top: 0.75rem;
    color: var(--on-paper-muted);
  }
  .reserve__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .reserve__alt {
    flex-basis: 100%;
    font-size: var(--step--1);
    color: var(--on-paper-muted);
    text-underline-offset: 0.2em;
  }
  @media (min-width: 56em) {
    .reserve__alt {
      text-align: right;
    }
  }
</style>
