---
/**
 * Click-to-play video facade. Renders a local poster (or a typographic card);
 * the YouTube/Facebook iframe is inserted only after the visitor presses play.
 * Without JS the card is a plain link to the video page.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { embedSrc, type VideoEntry } from '../data/videos';

interface Props {
  video: VideoEntry;
  poster?: ImageMetadata;
  posterAlt?: string;
  /** Poster carries the Afrolink watermark bottom-right — keep it in frame. */
  posterWatermarked?: boolean;
  size?: 'feature' | 'card';
  sizes?: string;
}

const { video, poster, posterAlt = '', posterWatermarked = false, size = 'card', sizes = '(min-width: 64em) 22rem, 70vw' } = Astro.props;
const platformName = video.platform === 'youtube' ? 'YouTube' : 'Facebook';
---

<figure class:list={['vcard', `vcard--${video.format}`, `vcard--${size}`]}>
  <div class="vcard__frame" data-video-frame>
    <a
      class="vcard__facade"
      href={video.url}
      target="_blank"
      rel="noopener"
      data-video-play
      data-embed={embedSrc(video)}
      data-title={`${video.title} — ${video.author} (${platformName})`}
    >
      {
        poster ? (
          <Picture
            src={poster}
            formats={['avif', 'webp']}
            widths={size === 'feature' ? [640, 960, 1280, 1600] : [360, 540, 720]}
            sizes={sizes}
            alt={posterAlt}
            loading="lazy"
            class:list={['vcard__poster', { 'is-watermarked': posterWatermarked }]}
          />
        ) : (
          <span class="vcard__type" aria-hidden="true">
            <span class="vcard__type-title">{video.platform === 'youtube' ? (video.format === 'portrait' ? 'YouTube Short' : 'YouTube') : 'Facebook video'}</span>
          </span>
        )
      }
      <span class="vcard__play" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"></path></svg>
      </span>
      <span class="visually-hidden">Play video: {video.title} by {video.author} on {platformName}</span>
    </a>
  </div>
  <figcaption class="vcard__cap">
    <span class="vcard__title">{video.title}</span>
    <span class="vcard__meta">{video.author} · {platformName}</span>
  </figcaption>
</figure>

<script>
  // One active video at a time: starting a new one restores the previous facade.
  let active: { frame: HTMLElement; facade: HTMLElement } | null = null;

  function stopActive() {
    if (!active) return;
    active.frame.querySelector('iframe')?.remove();
    active.facade.hidden = false;
    active = null;
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-video-play]').forEach((facade) => {
    facade.addEventListener('click', (ev) => {
      // Let modified clicks open the platform page in a new tab.
      if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.button !== 0) return;
      ev.preventDefault();
      const frame = facade.closest<HTMLElement>('[data-video-frame]');
      if (!frame) return;
      stopActive();
      const iframe = document.createElement('iframe');
      iframe.src = facade.dataset.embed!;
      iframe.title = facade.dataset.title ?? 'Video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.appendChild(iframe);
      facade.hidden = true;
      iframe.focus();
      active = { frame, facade };
    });
  });
</script>

<style>
  .vcard {
    min-width: 0;
  }
  .vcard__frame {
    position: relative;
    overflow: hidden;
    background: var(--ink-raised);
  }
  .vcard--landscape .vcard__frame {
    aspect-ratio: 16 / 9;
  }
  .vcard--portrait .vcard__frame {
    aspect-ratio: 9 / 16;
  }
  .vcard__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .vcard__facade {
    position: absolute;
    inset: 0;
    display: block;
    color: var(--on-ink);
    text-decoration: none;
    cursor: pointer;
  }
  .vcard__facade :global(picture),
  .vcard__poster {
    width: 100%;
    height: 100%;
  }
  .vcard__poster {
    object-fit: cover;
    object-position: 50% 45%;
    transition: transform 0.6s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .vcard__poster.is-watermarked {
    object-position: 100% 100%;
  }
  .vcard__facade::after {
    /* quiet scrim so the play control reads on any photo */
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(26 22 19 / 0.18);
    transition: background-color 0.3s ease;
  }

  .vcard__type {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 1.25rem;
    background: var(--ink-raised);
    border: 1px solid var(--ink-line);
  }
  .vcard__type::before {
    /* the site's lozenge device, scaled up as a poster mark */
    content: '';
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    width: 0.9rem;
    height: 0.9rem;
    background: var(--ochre);
    transform: rotate(45deg);
  }
  .vcard__type-title {
    position: relative;
    z-index: 1;
    font-family: var(--font-serif);
    font-size: var(--step-2);
    line-height: 1.15;
  }

  .vcard__play {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--ochre);
    color: var(--ink);
    transition: transform 0.25s ease, background-color 0.25s ease;
  }
  .vcard--card .vcard__play {
    width: 3.25rem;
    height: 3.25rem;
  }
  .vcard__play svg {
    width: 45%;
    height: 45%;
    margin-left: 8%;
  }
  .vcard__facade:hover .vcard__play,
  .vcard__facade:focus-visible .vcard__play {
    transform: scale(1.08);
    background: var(--on-ink);
  }
  .vcard__facade:hover::after {
    background: rgb(26 22 19 / 0.08);
  }
  @media (hover: hover) {
    .vcard__facade:hover .vcard__poster {
      transform: scale(1.03);
    }
  }
  .vcard__facade:focus-visible {
    outline: 3px solid var(--ochre);
    outline-offset: -3px;
  }

  .vcard__cap {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.75rem;
  }
  .vcard__title {
    font-weight: 550;
    line-height: 1.3;
  }
  .vcard--feature .vcard__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--step-2);
  }
  .vcard__meta {
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }
</style>
