---
/**
 * Two-click video facade. Renders a local poster (or a typographic card). The first click shows
 * an inline consent step naming the provider and the data transfer; the YouTube/Facebook iframe
 * is inserted only after "Load video" (once) or "Always allow external videos" (stored consent,
 * category "media", revocable in the privacy settings). Without JS the card is a plain link to
 * the video page (the visitor leaves the site).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { embedSrc, type VideoEntry } from '../data/videos';
import { routes, type Lang } from '../i18n/config';
import { useConsentUi } from '../i18n/consent';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  video: VideoEntry;
  poster?: ImageMetadata;
  posterAlt?: string;
  /** Poster carries the Afrolink watermark bottom-right — keep it in frame. */
  posterWatermarked?: boolean;
  size?: 'feature' | 'card';
  sizes?: string;
  tone?: 'ink' | 'paper';
}

const {
  lang,
  video,
  poster,
  posterAlt = '',
  posterWatermarked = false,
  size = 'card',
  sizes = '(min-width: 64em) 22rem, 70vw',
  tone = 'ink',
} = Astro.props;
const t = useT(lang);
const cv = useConsentUi(lang).video;
const platformName = video.platform === 'youtube' ? (video.format === 'portrait' ? t.videos.short : 'YouTube') : t.videos.fbVideo;
const title = video.titleL10n ? video.titleL10n[lang] : video.title;
---

<figure class:list={['vcard', `vcard--${video.format}`, `vcard--${size}`, `vcard--${tone}`]}>
  <div class="vcard__frame" data-video-frame>
    <a
      class="vcard__facade"
      href={video.url}
      target="_blank"
      rel="noopener"
      data-video-play
      data-embed={embedSrc(video)}
      data-title={`${title} — ${video.author}`}
    >
      {
        poster ? (
          <Picture
            src={poster}
            formats={['avif', 'webp']}
            widths={size === 'feature' ? [640, 960, 1280] : [360, 540, 720]}
            sizes={sizes}
            alt={posterAlt}
            loading="lazy"
            class:list={['vcard__poster', { 'is-watermarked': posterWatermarked }]}
          />
        ) : (
          <span class="vcard__type" aria-hidden="true">
            <span class="vcard__type-title">{platformName}</span>
          </span>
        )
      }
      <span class="vcard__play" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"></path></svg>
      </span>
      <span class="visually-hidden">{t.videos.play}: {title} – {video.author} {t.videos.on} {platformName}</span>
    </a>
    <div class="vcard__consent" role="group" aria-label={cv.title} data-video-consent hidden>
      <p class="vcard__consent-text">{video.platform === 'youtube' ? cv.youtube : cv.facebook}</p>
      <div class="vcard__consent-actions">
        <button type="button" class="vcard__btn vcard__btn--solid" data-video-load>{cv.loadOnce}</button>
        <button type="button" class="vcard__btn" data-video-always>{cv.always}</button>
        <button type="button" class="vcard__btn vcard__btn--plain" data-video-cancel>{cv.cancel}</button>
      </div>
      <a class="vcard__consent-more" href={routes.privacy[lang]}>{cv.more}</a>
    </div>
  </div>
  <figcaption class="vcard__cap">
    <span class="vcard__title">{title}</span>
    <span class="vcard__meta">{video.author} · {platformName}</span>
  </figcaption>
</figure>

<script>
  import { onConsentChange, readChoices, setChoice } from '../lib/consent';

  // One active video at a time: starting a new one restores the previous facade.
  let active: { frame: HTMLElement; facade: HTMLElement } | null = null;

  function stopActive() {
    if (!active) return;
    active.frame.querySelector('iframe')?.remove();
    active.facade.hidden = false;
    active = null;
  }

  function load(facade: HTMLAnchorElement) {
    const frame = facade.closest<HTMLElement>('[data-video-frame]');
    if (!frame) return;
    stopActive();
    const panel = frame.querySelector<HTMLElement>('[data-video-consent]');
    if (panel) panel.hidden = true;
    const iframe = document.createElement('iframe');
    iframe.src = facade.dataset.embed!;
    iframe.title = facade.dataset.title ?? 'Video';
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    frame.appendChild(iframe);
    facade.hidden = true;
    iframe.focus();
    active = { frame, facade };
  }

  document.querySelectorAll<HTMLAnchorElement>('[data-video-play]').forEach((facade) => {
    const frame = facade.closest<HTMLElement>('[data-video-frame]')!;
    const panel = frame.querySelector<HTMLElement>('[data-video-consent]')!;
    facade.addEventListener('click', (ev) => {
      // Let modified clicks open the platform page in a new tab.
      if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.button !== 0) return;
      ev.preventDefault();
      if (readChoices().media) {
        load(facade);
        return;
      }
      // First click: explain the provider and the data transfer before anything is loaded.
      panel.hidden = false;
      panel.querySelector<HTMLButtonElement>('[data-video-load]')?.focus();
    });
    panel.querySelector('[data-video-load]')?.addEventListener('click', () => load(facade));
    panel.querySelector('[data-video-always]')?.addEventListener('click', () => {
      setChoice('media', true);
      load(facade);
    });
    panel.querySelector('[data-video-cancel]')?.addEventListener('click', () => {
      panel.hidden = true;
      facade.focus();
    });
  });

  // Withdrawing consent stops a playing embedded video immediately.
  onConsentChange((c) => {
    if (!c.media) stopActive();
  });
</script>

<style>
  .vcard {
    min-width: 0;
  }
  .vcard__frame {
    position: relative;
    overflow: hidden;
    background: var(--ink-raised);
  }
  .vcard--landscape .vcard__frame {
    aspect-ratio: 16 / 9;
  }
  .vcard--portrait .vcard__frame {
    aspect-ratio: 9 / 16;
  }
  .vcard__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  /* While the consent step is shown, the frame grows to fit it (narrow cards, long translations). */
  .vcard__frame:has(> .vcard__consent:not([hidden])) {
    aspect-ratio: auto;
    min-height: 12rem;
  }
  .vcard__consent {
    position: relative;
    z-index: 2;
    display: grid;
    align-content: center;
    min-height: 100%;
    gap: 0.75rem;
    padding: clamp(0.9rem, 0.6rem + 1.5vw, 1.5rem);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--on-ink);
    background: rgb(20 17 16 / 0.94);
  }
  .vcard__consent[hidden] {
    display: none;
  }
  .vcard__consent-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .vcard__btn {
    min-height: 2.5rem;
    padding: 0.35rem 0.8rem;
    font: inherit;
    font-weight: 650;
    color: var(--on-ink);
    background: transparent;
    border: 1px solid rgb(214 168 78 / 0.7);
    cursor: pointer;
  }
  .vcard__btn--solid {
    color: var(--ink);
    background: var(--gold);
    border-color: var(--gold);
  }
  .vcard__btn--plain {
    border-color: transparent;
    text-decoration: underline;
  }
  .vcard__btn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .vcard__consent-more {
    font-size: var(--step--1);
    color: var(--gold);
  }
  .vcard__facade {
    position: absolute;
    inset: 0;
    display: block;
    color: var(--on-ink);
    text-decoration: none;
    cursor: pointer;
  }
  .vcard__facade :global(picture),
  .vcard__poster {
    width: 100%;
    height: 100%;
  }
  .vcard__poster {
    object-fit: cover;
    object-position: 50% 45%;
    transition: transform 0.6s cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .vcard__poster.is-watermarked {
    object-position: 100% 100%;
  }
  .vcard__facade::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(26 22 19 / 0.18);
    transition: background-color 0.3s ease;
  }
  .vcard__type {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 1.1rem;
    background: var(--ink-raised);
    border: 1px solid var(--ink-line);
  }
  .vcard__type::before {
    content: '';
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    width: 0.8rem;
    height: 0.8rem;
    background: var(--ochre);
    transform: rotate(45deg);
  }
  .vcard__type-title {
    position: relative;
    z-index: 1;
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--on-ink-muted);
  }
  .vcard__play {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--ochre);
    color: var(--ink);
    transition: transform 0.25s ease, background-color 0.25s ease;
  }
  .vcard--card .vcard__play {
    width: 3.25rem;
    height: 3.25rem;
  }
  .vcard__play svg {
    width: 45%;
    height: 45%;
    margin-left: 8%;
  }
  .vcard__facade:hover .vcard__play,
  .vcard__facade:focus-visible .vcard__play {
    transform: scale(1.08);
    background: var(--on-ink);
  }
  .vcard__facade:hover::after {
    background: rgb(26 22 19 / 0.08);
  }
  @media (hover: hover) {
    .vcard__facade:hover .vcard__poster {
      transform: scale(1.03);
    }
  }
  .vcard__facade:focus-visible {
    outline: 3px solid var(--ochre);
    outline-offset: -3px;
  }
  .vcard__cap {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.75rem;
  }
  .vcard__title {
    font-weight: 550;
    line-height: 1.3;
  }
  .vcard--feature .vcard__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--step-2);
  }
  .vcard__meta {
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }
  .vcard--paper .vcard__meta {
    color: var(--on-paper-muted);
  }
</style>
