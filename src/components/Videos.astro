---
import type { ImageMetadata } from 'astro';
import VideoCard from './VideoCard.astro';
import egusiYam from '../assets/gallery/egusi-yam.jpg';
import plantainMeat from '../assets/gallery/plantain-peppered-meat.jpg';
import { videos } from '../data/videos';
import { gallery } from '../data/gallery';
import { social } from '../data/business';
import { type Lang } from '../i18n/config';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const altOf = (file: string) => gallery.find((g) => g.file === file)?.alt[lang] ?? '';

// Posters only where the photo shows the dish the video's own caption names.
const posters: Record<string, { image: ImageMetadata; alt: string }> = {
  '24293417526931827': { image: egusiYam, alt: altOf('egusi-yam.jpg') },
  '2417411605311803': { image: plantainMeat, alt: altOf('plantain-peppered-meat.jpg') },
};
---

<section class="section on-ink videos" id="videos" aria-labelledby="videos-title">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">{t.videos.eyebrow}</p>
      <h2 id="videos-title" class="section-title">{t.videos.title}</h2>
      <p class="section-lede">{t.videos.lede}</p>
    </header>

    <ul role="list" class="vrow">
      {
        videos.map((v) => (
          <li>
            <VideoCard
              lang={lang}
              video={v}
              poster={posters[v.id]?.image}
              posterAlt={posters[v.id]?.alt}
              posterWatermarked
              sizes="(min-width: 75em) 14rem, (min-width: 48em) 30vw, 62vw"
            />
          </li>
        ))
      }
    </ul>

    <div class="follow">
      <h3 class="follow__h">{t.videos.follow}</h3>
      <ul role="list" class="follow__list">
        {
          social.map((s) => (
            <li>
              <a class="follow__link" href={s.href} target="_blank" rel="noopener">
                <span class="follow__name">{s.name}</span>
                <span class="follow__handle">{s.handle}</span>
                <span class="visually-hidden"> {t.a11y.opensNewTab}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .vrow {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(62vw, 15rem);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    margin-inline: calc(-1 * var(--gutter));
    padding: 0 var(--gutter) 1rem;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--ink-line) transparent;
  }
  .vrow > li {
    scroll-snap-align: start;
  }
  @media (min-width: 75em) {
    .vrow {
      grid-auto-flow: row;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }
  }
  .follow {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid var(--ink-line);
  }
  .follow__h {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--step-2);
  }
  .follow__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1rem;
  }
  @media (min-width: 56em) {
    .follow__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0 2rem;
    }
  }
  .follow__link {
    display: grid;
    gap: 0.1rem;
    padding: 0.9rem 0;
    min-height: 3rem;
    text-decoration: none;
    border-bottom: 1px solid var(--ink-line);
  }
  .follow__name {
    font-weight: 600;
  }
  .follow__handle {
    font-size: var(--step--1);
    color: var(--on-ink-muted);
    overflow-wrap: anywhere;
  }
  .follow__link:hover .follow__name {
    color: var(--ochre);
  }
</style>
