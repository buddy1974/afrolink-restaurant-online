---
/**
 * Cookie policy — generated from src/data/storage-inventory.ts, grouped by consent category.
 * Rating-related entries appear only in builds with ratings enabled.
 */
import LegalShell from '../LegalShell.astro';
import { storageInventory, type ConsentCategory } from '../../data/storage-inventory';
import { type Lang } from '../../i18n/config';
import { useConsentUi } from '../../i18n/consent';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = useConsentUi(lang);
const c = ui.page;
const ratingsOn = process.env.RATINGS_ENABLED === 'true';
const items = storageInventory.filter((i) => ratingsOn || !i.ratingsOnly);
const groups: { cat: ConsentCategory; title: string; basis: string }[] = [
  { cat: 'necessary', title: c.catNecessary, basis: c.basisNecessary },
  { cat: 'media', title: c.catMedia, basis: c.basisConsent },
  { cat: 'prefs', title: c.catPrefs, basis: c.basisConsent },
  { cat: 'ratings', title: c.catRatings, basis: c.basisConsent },
];
---

<LegalShell lang={lang} route="cookies" title={c.title} lede={c.lede}>
  <section aria-labelledby="ck-summary">
    <h2 id="ck-summary">{c.summaryTitle}</h2>
    {c.summary.map((p) => <p>{p}</p>)}
    <p>
      <button type="button" class="btn btn--solid" data-open-consent>{ui.settings.open}</button>
    </p>
  </section>

  <section aria-labelledby="ck-table">
    <h2 id="ck-table">{c.tableTitle}</h2>
    {
      groups.map((g) => {
        const list = items.filter((i) => i.category === g.cat);
        return list.length === 0 ? null : (
          <section class="ck-group" aria-labelledby={`ck-${g.cat}`}>
            <h3 id={`ck-${g.cat}`}>{g.title}</h3>
            {list.map((i) => (
              <dl class="ck-item">
                <div>
                  <dt>{c.colName}</dt>
                  <dd>
                    <code>{i.name}</code>
                  </dd>
                </div>
                <div>
                  <dt>{c.colType}</dt>
                  <dd>{c.types[i.type]}</dd>
                </div>
                <div>
                  <dt>{c.colProvider}</dt>
                  <dd>{i.provider}</dd>
                </div>
                <div>
                  <dt>{c.colPurpose}</dt>
                  <dd>{i.purpose[lang]}</dd>
                </div>
                <div>
                  <dt>{c.colWhen}</dt>
                  <dd>{i.setWhen[lang]}</dd>
                </div>
                <div>
                  <dt>{c.colDuration}</dt>
                  <dd>{i.duration[lang]}</dd>
                </div>
                <div>
                  <dt>{c.colBasis}</dt>
                  <dd>{g.basis}</dd>
                </div>
              </dl>
            ))}
          </section>
        );
      })
    }
  </section>

  <section aria-labelledby="ck-none">
    <h2 id="ck-none">{c.noneTitle}</h2>
    <p>{c.none}</p>
  </section>

  <section aria-labelledby="ck-change">
    <h2 id="ck-change">{c.changeTitle}</h2>
    <p>{c.changeText}</p>
    <p>
      <button type="button" class="btn btn--solid" data-open-consent>{ui.settings.open}</button>
    </p>
  </section>
</LegalShell>

<style>
  .ck-group {
    margin-top: 1.5rem;
  }
  .ck-group h3 {
    margin-bottom: 0.75rem;
    font-size: var(--step-1);
  }
  .ck-item {
    display: grid;
    margin-bottom: 1rem;
    border-top: 1px solid var(--paper-line);
  }
  .ck-item > div {
    display: grid;
    gap: 0.15rem 1.5rem;
    padding-block: 0.55rem;
    border-bottom: 1px solid var(--paper-line);
  }
  @media (min-width: 48em) {
    .ck-item > div {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
  .ck-item dt {
    font-weight: 600;
  }
  .ck-item dd {
    margin: 0;
  }
  .ck-item code {
    font-size: 0.95em;
    word-break: break-word;
  }
</style>
