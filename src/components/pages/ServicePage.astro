---
/**
 * Delivery, catering and reservation pages. Copy only restates owner-confirmed terms:
 * everything by arrangement, no fixed fees, times, areas, packages or online payment.
 */
import PageShell from '../PageShell.astro';
import Enquiry from '../Enquiry.astro';
import HoursContact from '../HoursContact.astro';
import Icon from '../Icon.astro';
import { phones, whatsapp } from '../../data/business';
import { serviceJsonLd } from '../../data/seo';
import { dishPaths, routes, type Lang } from '../../i18n/config';
import { useT } from '../../i18n/ui';
import { usePages } from '../../i18n/pages';

interface Props {
  lang: Lang;
  kind: 'delivery' | 'catering' | 'reservations';
}
const { lang, kind } = Astro.props;
const t = useT(lang);
const p = usePages(lang);
const c = p[kind];
const href = routes[kind][lang];
const jsonLd =
  kind === 'delivery'
    ? [serviceJsonLd(lang, href, c.h1, c.description, 'Food delivery', 'Essen')]
    : kind === 'catering'
      ? [serviceJsonLd(lang, href, c.h1, c.description, 'Catering')]
      : [];
const preset = kind === 'reservations' ? 'reservation' : kind;
const groupDishes = ['jollof-rice', 'fried-rice', 'suya', 'assorted-plate', 'egusi-soup'] as const;
const groupNames: Record<(typeof groupDishes)[number], string> = {
  'jollof-rice': 'Jollof Rice',
  'fried-rice': 'Fried Rice',
  suya: 'Suya',
  'assorted-plate': 'Assorted Plate',
  'egusi-soup': 'Egusi Soup',
};
---

<PageShell
  lang={lang}
  route={kind}
  title={c.title}
  description={c.description}
  crumbs={[{ name: p.nav[kind], href }]}
  h1={c.h1}
  lede={c.lede}
  jsonLd={jsonLd}
>
  <div class="wrap svc">
    <div class="svc__grid">
      <div class="svc__text">
        <p>{c.p1}</p>
        <p>{c.p2}</p>
        {kind === 'catering' && <p class="svc__outside">{p.catering.outside}</p>}
        <div class="svc__actions">
          <a class="btn btn--solid" href={phones.landline.href}><Icon name="phone" /> {p.cta.call} {phones.landline.display}</a>
          <a class="btn btn--line" href={whatsapp.href} target="_blank" rel="noopener">
            <Icon name="whatsapp" /> {p.cta.whatsapp}<span class="visually-hidden"> {t.a11y.opensWhatsApp}</span>
          </a>
          <a class="btn btn--line" href="#enquiry">{p.cta.enquire}</a>
        </div>
      </div>

      <aside class="svc__side">
        {
          kind === 'delivery' && (
            <>
              <h2 class="svc__h2">{t.services.deliveryHow}</h2>
              <ol class="svc__steps">
                {t.services.deliverySteps.map((s) => (
                  <li>{s}</li>
                ))}
              </ol>
            </>
          )
        }
        {
          kind === 'catering' && (
            <>
              <h2 class="svc__h2">{p.catering.stepsTitle}</h2>
              <ol class="svc__steps">
                {p.catering.steps.map((s) => (
                  <li>{s}</li>
                ))}
              </ol>
              <h2 class="svc__h2">{t.services.occasions}</h2>
              <ul role="list" class="svc__tags">
                {t.services.occasionList.map((o) => (
                  <li>{o}</li>
                ))}
              </ul>
            </>
          )
        }
        {
          kind === 'reservations' && (
            <>
              <h2 class="svc__h2">{p.cta.call}</h2>
              <p class="svc__phone">
                <a href={phones.landline.href}>{phones.landline.display}</a>
                <br />
                <a href={phones.mobile.href}>{phones.mobile.display}</a>
              </p>
            </>
          )
        }
        {
          kind !== 'reservations' && (
            <>
              <h2 class="svc__h2">{kind === 'catering' ? p.catering.dishesTitle : p.nav.dishes}</h2>
              <ul role="list" class="svc__dishes">
                {groupDishes.map((id) => (
                  <li>
                    <a href={dishPaths(id)[lang]}>{groupNames[id]}</a>
                  </li>
                ))}
                <li>
                  <a href={routes.menu[lang]}>{p.cta.seeAll} →</a>
                </li>
              </ul>
            </>
          )
        }
      </aside>
    </div>

    {
      kind === 'delivery' && (
        <section class="svc__faq" aria-labelledby="faq-title">
          <h2 id="faq-title" class="svc__h2">{p.delivery.faqTitle}</h2>
          <dl>
            {p.delivery.faq.map((f) => {
              const [q, a] = f.split('|');
              return (
                <div>
                  <dt>{q}</dt>
                  <dd>{a}</dd>
                </div>
              );
            })}
          </dl>
        </section>
      )
    }
  </div>

  {kind === 'reservations' && <HoursContact lang={lang} />}

  <div class="svc__enquiry on-ink">
    <div class="wrap">
      <p class="svc__note">{t.services.note}</p>
      <Enquiry lang={lang} preset={preset} headingLevel={2} />
    </div>
  </div>
</PageShell>

<style>
  .svc {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .svc__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 64em) {
    .svc__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: clamp(2rem, 1rem + 4vw, 5rem);
    }
  }
  .svc__text {
    display: grid;
    gap: 1rem;
    align-content: start;
    max-width: var(--measure);
    font-size: var(--step-1);
    color: var(--on-paper-muted);
  }
  .svc__outside {
    padding: 0.9rem 1.1rem;
    font-size: var(--step-0);
    background: var(--paper-sunk);
    border-left: 3px solid var(--gold);
  }
  .svc__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }
  .svc__side {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border: 1px solid var(--paper-line);
    background: var(--ink-raised);
  }
  .svc__h2 {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: var(--step-2);
    line-height: 1.15;
  }
  .svc__steps {
    display: grid;
    gap: 0.5rem;
    padding-left: 1.25rem;
    color: var(--on-paper-muted);
  }
  .svc__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .svc__tags li {
    padding: 0.25rem 0.7rem;
    font-size: var(--step--1);
    border: 1px solid var(--paper-line);
    border-radius: 999px;
  }
  .svc__dishes {
    display: grid;
    gap: 0.35rem;
  }
  .svc__dishes a,
  .svc__phone a {
    font-weight: 600;
    color: var(--gold);
  }
  .svc__phone {
    font-size: var(--step-1);
    line-height: 1.8;
  }
  .svc__faq dl {
    display: grid;
    gap: 1.25rem;
    max-width: var(--measure);
    margin-top: 1rem;
  }
  .svc__faq dt {
    font-weight: 650;
  }
  .svc__faq dd {
    margin-top: 0.25rem;
    color: var(--on-paper-muted);
  }
  .svc__enquiry {
    padding-block: 0 var(--section);
  }
  .svc__note {
    padding-top: 2rem;
    font-size: var(--step--1);
    color: var(--on-ink-muted);
  }
</style>
