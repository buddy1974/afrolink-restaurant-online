---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/newsreader/index.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/global.css';
// Critical fonts for the hero (preloaded to speed up first paint and avoid late swaps).
import archivoWdth from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import newsreaderItalic from '@fontsource-variable/newsreader/files/newsreader-latin-wght-italic.woff2?url';
import { siteUrl } from '../data/business';
import { absolute, alternates, restaurantJsonLd, themeColor, websiteJsonLd } from '../data/seo';
import { htmlLang, ogLocale, locales, routes, type Lang, type Paths, type RouteKey } from '../i18n/config';
import { useT } from '../i18n/ui';
import Lightbox from '../components/Lightbox.astro';
import RatingsClient from '../components/RatingsClient.astro';
import ConsentSettings from '../components/ConsentSettings.astro';

interface Props {
  lang: Lang;
  route: RouteKey;
  title?: string;
  description?: string;
  /** Emit Restaurant JSON-LD (home pages only). */
  structuredData?: boolean;
  /** Localized paths when the page is not a fixed route (dish pages). */
  paths?: Paths;
  /** Additional JSON-LD nodes (breadcrumbs, web page, menu item …). */
  jsonLd?: object[];
  /** Absolute URL of a page-specific social image (defaults to the branded OG image). */
  image?: { url: string; width: number; height: number; alt: string };
}

const { lang, route, title, description, structuredData = false, jsonLd: extraLd = [], image } = Astro.props;
const paths = Astro.props.paths ?? routes[route];
const t = useT(lang);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const canonical = absolute(paths[lang]);
const ogImage = image?.url ?? `${siteUrl}/og-image.jpg`;
const ld = [...(structuredData ? [restaurantJsonLd(lang, `${siteUrl}/og-image.jpg`, `${siteUrl}/icon-512.png`), websiteJsonLd(lang)] : []), ...extraLd];
const jsonLd = ld.length ? ld : null;
// Language detection happens server-side on "/" (vercel.json, Accept-Language header) —
// no script reads browser properties or storage.
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={archivoWdth} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={newsreaderItalic} as="font" type="font/woff2" crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {alternates(paths).map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content={themeColor} />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={route === 'home' ? 'restaurant.restaurant' : 'website'} />
    <meta property="og:site_name" content="Afrolink Restaurant & Bar" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(image?.width ?? 1200)} />
    <meta property="og:image:height" content={String(image?.height ?? 630)} />
    <meta property="og:image:alt" content={image?.alt ?? t.meta.ogAlt} />
    <meta property="restaurant:contact_info:street_address" content="Berzeliusstraße 7" />
    <meta property="restaurant:contact_info:locality" content="Essen" />
    <meta property="restaurant:contact_info:postal_code" content="45144" />
    <meta property="restaurant:contact_info:country_name" content="Germany" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href={route === 'home' ? '#menu' : '#main'}>{route === 'home' ? t.a11y.skipToMenu : t.a11y.skipToContent}</a>
    <slot />
    <Lightbox lang={lang} />
    <RatingsClient lang={lang} />
    <ConsentSettings lang={lang} />
  </body>
</html>
