{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "regions": [
    "fra1"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "afrolink-restaurant.online"
        }
      ],
      "destination": "https://www.afrolink-restaurant.online/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "afl_lang",
          "value": "en"
        }
      ],
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "cookie",
          "key": "afl_lang",
          "value": "fr"
        }
      ],
      "destination": "/fr/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^en(?:-[A-Za-z0-9]+)?(?:[,;].*)?$"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "afl_lang"
        },
        {
          "type": "header",
          "key": "referer",
          "value": "^(?:https?://(?:www\\.)?afrolink-restaurant\\.online|https?://[^/]+\\.vercel\\.app)(?:/.*)?$"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:[Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|Lighthouse|HeadlessChrome|facebookexternalhit|WhatsApp|[Pp]review).*"
        }
      ],
      "destination": "/en/",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^fr(?:-[A-Za-z0-9]+)?(?:[,;].*)?$"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "afl_lang"
        },
        {
          "type": "header",
          "key": "referer",
          "value": "^(?:https?://(?:www\\.)?afrolink-restaurant\\.online|https?://[^/]+\\.vercel\\.app)(?:/.*)?$"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:[Bb]ot|[Cc]rawl|[Ss]pider|[Ss]lurp|Lighthouse|HeadlessChrome|facebookexternalhit|WhatsApp|[Pp]review).*"
        }
      ],
      "destination": "/fr/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
